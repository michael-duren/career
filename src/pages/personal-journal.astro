---
import DocsLayout from '../layouts/DocsLayout.astro';
import { WorkspaceEditor } from '../components/WorkspaceEditor';
---
<DocsLayout title="Personal journal" description="Life, reflections, and personal background">
  <header class="mb-6 space-y-2">
    <h1 class="text-3xl font-bold">Personal journal</h1>
    <p class="text-zinc-400">A place for life outside work, personal history, and reflections.</p>
    <p class="text-sm"><a class="text-blue-400 underline" href="/journal">Work journal</a> · <a class="text-blue-400 underline" href="/api/agent-context?format=markdown&journal=personal">Read personal journal as Markdown</a></p>
  </header>
  <WorkspaceEditor kind="personal" client:load />
</DocsLayout>
