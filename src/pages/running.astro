---
import DocsLayout from '../layouts/DocsLayout.astro';
import RunningRecorder from '../components/RunningRecorder';
import { WorkspaceEditor } from '../components/WorkspaceEditor';
---
<DocsLayout title="Running notes" description="Private voice memos and transcripts">
  <header class="mb-6 space-y-2"><h1 class="text-3xl font-bold">Running notes</h1><p class="text-zinc-400">Record locally, sync when connected, and transcribe on your homelab.</p><a class="text-sm text-blue-400 underline" href="/api/agent-context?format=markdown&journal=running">Share running context explicitly</a></header>
  <RunningRecorder client:load />
  <WorkspaceEditor kind="run" client:load />
</DocsLayout>
