---
import DocsLayout from '../layouts/DocsLayout.astro';
import { WorkspaceEditor } from '../components/WorkspaceEditor';
---
<DocsLayout page title="Audio thoughts" description="Private voice memos and transcripts">
  <WorkspaceEditor kind="run" client:load />
</DocsLayout>
<style is:global>
  /* Reading a thought shows just the note, unless the recorder needs attention. */
  body:has([data-thought-reading]) [data-recorder]:not([data-recorder-active]) { display: none; }
</style>
