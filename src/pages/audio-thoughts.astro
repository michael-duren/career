---
import DocsLayout from '../layouts/DocsLayout.astro';
import RunningRecorder from '../components/RunningRecorder';
import { WorkspaceEditor } from '../components/WorkspaceEditor';
---
<DocsLayout title="Audio thoughts" description="Private voice memos and transcripts">
  <header class="mb-6 space-y-2"><h1 class="text-3xl font-bold">Audio thoughts</h1><p class="text-zinc-400">Record locally, sync when connected, and transcribe on your homelab.</p><a class="text-sm text-blue-400 underline" href="/api/agent-context?format=markdown&journal=running">Share audio thoughts context explicitly</a></header>
  <RunningRecorder client:load />
  <WorkspaceEditor kind="run" client:load />
</DocsLayout>
<style is:global>
  /* Reading a thought shows just the note, unless a take is still recording. */
  body:has([data-thought-reading]) [data-recorder]:not([data-recording]) { display: none; }
</style>
