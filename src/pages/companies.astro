---
import DocsLayout from '../layouts/DocsLayout.astro';
import { CompaniesView } from '../components/StaticDataViews';
---

<DocsLayout wide title="Companies" description="Target companies for the January/February 2027 application push, tiered by fit">
  <div class="space-y-2 mb-4">
    <h1 class="text-3xl font-bold">Job Application Targets</h1>
    <p class="text-zinc-400 text-sm">
      January/February 2027 targets for SRE and infrastructure roles. Apply first to
      observability and database companies, then cloud-native infrastructure. Big tech is
      a stretch target; AI infrastructure is a longer-term watchlist.
    </p>
  </div>

  <a class="mb-4 inline-block rounded-lg bg-blue-600 px-4 py-2 text-sm text-white hover:bg-blue-500" href="/manage/companies">Add or edit companies</a>

  <CompaniesView client:only="react" />
</DocsLayout>
