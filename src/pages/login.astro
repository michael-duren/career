---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

---

<Layout title="Login - Career Strategy">
  <div class="flex min-h-dvh flex-col bg-paper px-[22px] py-[22px] text-ink md:px-14 md:py-10">
    <header class="box-content flex h-7 items-center justify-between border-b border-ink-30 pb-3">
      <span class="text-[13px] font-medium tracking-[0.32em]">CAREER</span>
      <span class="ui-label">Sign in</span>
    </header>

    <main class="flex flex-1 items-center justify-center py-8 md:py-10">
      <div class="flex w-full max-w-[420px] flex-col gap-8">
        <div class="flex flex-col gap-3">
          <h1 class="m-0 text-[40px] font-extralight leading-[0.9] md:text-[52px]">Sign in</h1>
          <p class="m-0 text-base font-light text-ink-60">Your career plan, goals and practice log.</p>
        </div>

        <form id="login-form" class="ui-box flex flex-col gap-7 p-6 md:p-8">
          <label class="ui-field">
            <span class="ui-label">Username</span>
            <input
              id="username"
              name="username"
              type="text"
              autocomplete="username" autocapitalize="none" spellcheck="false"
              required
              class="ui-field__input"
              placeholder="Enter username"
            >
          </label>
          <label class="ui-field">
            <span class="ui-label">Password</span>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="ui-field__input"
              placeholder="Enter password"
            >
          </label>

          <p id="error-message" role="alert" class="m-0 hidden text-sm text-accent"></p>

          <div class="flex flex-col gap-3">
            <button type="submit" class="ui-btn ui-btn--primary w-full">Sign in</button>
            <button type="reset" class="ui-btn w-full">Cancel</button>
          </div>
        </form>

        <p class="ui-label m-0 text-center">Personal career development tracking system</p>
      </div>
    </main>
  </div>

  <script>
    import { AuthService } from '../lib/auth';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorMessage = document.getElementById('error-message') as HTMLParagraphElement;

    form.addEventListener('reset', () => { errorMessage.classList.add('hidden'); errorMessage.textContent = ''; });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const username = formData.get('username') as string;
      const password = formData.get('password') as string;

      // Clear previous errors
      errorMessage.classList.add('hidden');
      errorMessage.textContent = '';

      try {
        const result = await AuthService.login(username, password);

        if (result.authenticated) {
          // Redirect to home or previous page
          // Resolve before checking: browsers treat paths like /\evil.com as protocol-relative.
          const redirectTo = new URL(new URLSearchParams(window.location.search).get('redirect') || '/', window.location.origin);
          window.location.href = redirectTo.origin === window.location.origin ? redirectTo.pathname + redirectTo.search + redirectTo.hash : '/';
        } else {
          errorMessage.textContent = result.error || 'Invalid credentials';
          errorMessage.classList.remove('hidden');
        }
      } catch (error) {
        errorMessage.textContent = 'An error occurred. Please try again.';
        errorMessage.classList.remove('hidden');
      }
    });
  </script>
</Layout>
