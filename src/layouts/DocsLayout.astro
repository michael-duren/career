---
import PwaHead from '../components/PwaHead.astro';
import ThemeHead from '../components/ThemeHead.astro';
import { DEFAULT_THEME } from '../lib/theme';
import '../styles/global.css';
import AppHeader from '../components/AppHeader.astro';

export interface Props {
  title?: string;
  wide?: boolean;
  /** Redesigned page: full width, side gutters lined up with the app header. */
  page?: boolean;
  description?: string;
}

const { wide = false, page = false, title = 'Career Strategy', description = 'Personal career development and study plan documentation' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="UTF-8" />
    <ThemeHead />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <PwaHead />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <AppHeader />
    <main id="main-content" class="min-w-0">
      <div class:list={page ? "app-content app-content--page" : ["app-content mx-auto px-4 sm:px-6", wide ? "max-w-7xl py-6" : "max-w-4xl py-12"]}>
        {(/^\/2026\/(os-oss|languages|system-design)(\/|$)/.test(Astro.url.pathname)) && <aside class="mb-6 rounded border border-zinc-700 p-4 text-sm text-zinc-400">Archived reference from the earlier curriculum. <a href="/2026/career-study-plan" class="text-blue-400 underline">View the current study plan.</a></aside>}
        <slot />
      </div>
    </main>
  </body>
</html>
