---
// Header search field and results panel. Styles: public/ui/shell.css; behavior: public/ui/site-search.js
// (shared with the Go-rendered pages, which render the same markup in internal/shell/header.templ).
---
<div class="site-search" role="search" aria-label="Site search">
  <div class="search-field">
    <svg class="search-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1"><circle cx="6" cy="6" r="4.5"></circle><path d="M9.5 9.5 L13 13"></path></svg>
    <label for="site-search" class="ui-sr-only">Search everything</label>
    <input id="site-search" type="search" placeholder="Search everything" autocomplete="off"
      aria-controls="search-panel" aria-expanded="false" aria-describedby="search-status" aria-keyshortcuts="/" />
    <button id="search-clear" type="button" aria-label="Clear search" hidden>×</button>
    <kbd class="search-shortcut" aria-hidden="true">/</kbd>
  </div>
  <div id="search-panel" hidden>
    <div class="search-panel-top"><span>Your workspace</span>
      <select id="search-kind" aria-label="Search collection"><option value="">All collections</option><option value="note">Notes</option><option value="document">Documents</option><option value="book">Books</option><option value="company">Companies</option><option value="connection">Connections</option><option value="week">Work journal</option><option value="personal">Personal journal</option><option value="run">Audio thoughts</option></select>
    </div>
    <p id="search-status" role="status"></p>
    <ul id="search-results" aria-label="Search results"></ul>
    <div class="search-panel-footer"><span><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span></div>
  </div>
</div>
<script is:inline type="module" src="/ui/site-search.js"></script>
