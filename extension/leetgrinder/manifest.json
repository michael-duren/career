{
  "manifest_version": 3,
  "name": "Leetgrinder",
  "version": "0.1.0",
  "description": "Logs LeetCode submissions to your Leetgrinder app after you confirm them.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "leetgrinder@career-strategy.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["browser-shim.js", "lib.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["leetcode-detect.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["browser-shim.js", "lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
