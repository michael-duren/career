// Package shell renders the app header for Go-rendered pages (docs/redesign/shell.md):
// the desktop header and, below 768px, the phone top bar and tab bar. It mirrors src/components/AppHeader.astro and SiteSearch.astro: the
// same markup, styled by /ui/shell.css and driven by /ui/shell.js and /ui/site-search.js.
package shell

import (
	"strings"

	"github.com/michael-duren/career-strategy/internal/modules"
)

// Link is one header menu entry: Home, then every module in registry order.
// shell.js hides turned-off modules and applies the user's order in the browser.
type Link struct {
	ID     string
	Short  string
	Href   string
	Routes string
}

// Links returns Home followed by every module's short label and main route.
func Links() []Link {
	links := []Link{{ID: "home", Short: "HOME", Href: "/", Routes: "/"}}
	for _, m := range modules.Registry {
		links = append(links, Link{ID: m.ID, Short: m.Short, Href: m.Pages[0], Routes: strings.Join(m.Pages, " ")})
	}
	return links
}

// Head links the header's tokens and styles. Put it before the page's own
// stylesheet so the page keeps its own custom properties.
templ Head() {
	<link rel="stylesheet" href="/ui/tokens.css"/>
	<link rel="stylesheet" href="/ui/primitives.css"/>
	<link rel="stylesheet" href="/ui/shell.css"/>
}

// Header renders the header with current (a module id, or "home") marked as
// the current page, plus the phone search button and tab bar.
templ Header(current string) {
	<header class="app-header" data-app-header>
		<div class="app-header-row">
			<span class="app-wordmark">CAREER</span>
			<nav aria-label="Main" class="app-nav">
				<ul class="app-menu" data-app-menu>
					for _, link := range Links() {
						<li data-module-id={ link.ID } data-routes={ link.Routes }>
							if link.ID == current {
								<a class="app-link" href={ templ.SafeURL(link.Href) } aria-current="page">{ link.Short }</a>
							} else {
								<a class="app-link" href={ templ.SafeURL(link.Href) }>{ link.Short }</a>
							}
						</li>
					}
					<li class="app-more" data-app-more hidden>
						<button type="button" class="app-link" aria-expanded="false" aria-controls="app-more-menu">MORE +</button>
						<ul id="app-more-menu" class="app-more-menu" data-app-more-menu hidden>
						</ul>
					</li>
				</ul>
			</nav>
			<div id="site-search-box" class="site-search" role="search" aria-label="Site search">
				<div class="search-field">
					<svg class="search-icon" aria-hidden="true" width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1"><circle cx="6" cy="6" r="4.5"></circle><path d="M9.5 9.5 L13 13"></path></svg>
					<label for="site-search" class="ui-sr-only">Search everything</label>
					<input id="site-search" type="search" placeholder="Search everything" autocomplete="off" aria-controls="search-panel" aria-expanded="false" aria-describedby="search-status" aria-keyshortcuts="/"/>
					<button id="search-clear" type="button" aria-label="Clear search" hidden>×</button>
					<kbd class="search-shortcut" aria-hidden="true">/</kbd>
				</div>
				<button type="button" class="search-cancel" data-app-search-cancel>Cancel</button>
				<div id="search-panel" hidden>
					<p id="search-status" role="status"></p>
					<div id="search-results"></div>
					<div id="search-recent" hidden>
						<h2 id="search-recent-title">Recent</h2>
						<div id="search-recent-list" role="group" aria-labelledby="search-recent-title"></div>
					</div>
					<div class="search-panel-footer"><span><kbd>↑</kbd><kbd>↓</kbd> navigate <kbd>↵</kbd> open</span><span><kbd>esc</kbd> close</span></div>
				</div>
			</div>
			<button type="button" class="app-search-toggle" aria-label="Search everything" aria-controls="site-search-box" aria-expanded="false" data-app-search-toggle>
				<svg aria-hidden="true" width="17" height="17" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1"><circle cx="6" cy="6" r="4.5"></circle><path d="M9.5 9.5 L13 13"></path></svg>
			</button>
			<a class="app-settings" href="/settings/modules" aria-label="Settings">
				<svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1"><circle cx="8" cy="8" r="2.5"></circle><path d="M8 1 V3.5 M8 12.5 V15 M1 8 H3.5 M12.5 8 H15 M3 3 L4.8 4.8 M11.2 11.2 L13 13 M3 13 L4.8 11.2 M11.2 4.8 L13 3"></path></svg>
			</a>
			<time class="app-clock" data-app-clock></time>
		</div>
		<nav class="app-tabbar" aria-label="Main" data-app-tabbar>
			for _, tab := range Tabs() {
				<a
					class="app-tab"
					href={ templ.SafeURL(tab.Href) }
					data-module-id={ tab.ID }
					data-routes={ tab.Routes }
					hidden?={ tab.Hidden }
					if tab.ID == currentTab(current) {
						aria-current="page"
					}
				>
					<svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.2">
						for _, d := range tab.Icon {
							<path d={ d }></path>
						}
					</svg>
					{ tab.Short }
				</a>
			}
		</nav>
	</header>
	<script type="module" src="/ui/shell.js"></script>
	<script type="module" src="/ui/site-search.js"></script>
}
