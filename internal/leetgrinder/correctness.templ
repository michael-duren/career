package leetgrinder

templ correctnessFields(c Correctness) {
	<fieldset class="correctness">
		<legend>Correctness reasoning <span class="muted">(optional)</span></legend>
		for _, field := range c.Fields() {
			if field.Name == "initially" {
				<p>Why it holds</p>
			}
			<label>
				{ field.Label }
				<span class="small muted">{ field.Hint }</span>
				<textarea name={ field.Name } rows="3" maxlength="2000">{ "\n" + field.Value }</textarea>
			</label>
		}
	</fieldset>
}

templ correctnessAnswers(c Correctness) {
	if c != (Correctness{}) {
		<details class="correctness-answers" open>
			<summary>Correctness reasoning</summary>
			for _, field := range c.Fields() {
				if field.Value != "" {
					<p><strong>{ field.Label }</strong></p>
					<p class="notes">{ field.Value }</p>
				}
			}
		</details>
	}
}

// correctnessFeedback lays Claude's correctness feedback out by section, or as
// plain text when it has no recognisable labels.
templ correctnessFeedback(text string) {
	if sections := CorrectnessSections(text); sections != nil {
		<div class="feedback-sections">
			for _, s := range sections {
				<section class={ "feedback-section", templ.KV("feedback-step", s.Step) }>
					if s.Label != "" {
						<h6>{ s.Label }</h6>
					}
					if s.Body != "" {
						<p class="notes">{ s.Body }</p>
					}
				</section>
			}
		</div>
	} else {
		<p class="notes">{ text }</p>
	}
}
