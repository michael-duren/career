package leetgrinder

templ layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Track LeetCode practice with a daily goal and spaced-repetition reviews."/>
			<title>{ title } · Leetgrinder</title>
			<link rel="icon" href="/favicon.svg"/>
			<link rel="stylesheet" href="/leetgrinder/style.css"/>
		</head>
		<body>
			<a class="skip" href="#main">Skip to content</a>
			<div class="shell">
				<nav class="sidenav" aria-label="Leetgrinder">
					<a class="sidenav-back" href="/">
						@icon("arrow-left")
						Career Strategy
					</a>
					<p class="sidenav-brand">
						@icon("terminal")
						Leetgrinder
					</p>
					<div class="sidenav-links">
						@navLink("/leetgrinder", "Dashboard", "dashboard", active)
						@navLink("/leetgrinder/problems", "Problems", "problems", active)
						@navLink("/leetgrinder/reviews", "Reviews", "reviews", active)
						@navLink("/leetgrinder/settings", "Settings", "settings", active)
					</div>
					<a class="sidenav-foot" href="/leetgrinder/export">
						@icon("download")
						Export history
					</a>
				</nav>
				<main id="main">
					{ children... }
				</main>
			</div>
			@complexityScript()
		</body>
	</html>
}

templ navLink(href string, label string, key string, active string) {
	if key == active {
		<a href={ templ.SafeURL(href) } aria-current="page">
			@icon(key)
			<span>{ label }</span>
		</a>
	} else {
		<a href={ templ.SafeURL(href) }>
			@icon(key)
			<span>{ label }</span>
		</a>
	}
}

// icon draws Lucide outline icons inline so pages need no icon font.
templ icon(name string) {
	<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		switch name {
			case "dashboard":
				<rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect>
			case "problems":
				<path d="M3 5h.01"></path><path d="M3 12h.01"></path><path d="M3 19h.01"></path><path d="M8 5h13"></path><path d="M8 12h13"></path><path d="M8 19h13"></path>
			case "reviews":
				<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path>
			case "settings":
				<path d="M20 7h-9"></path><path d="M14 17H5"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle>
			case "download":
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path>
			case "arrow-left":
				<path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>
			case "warning":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path>
			case "terminal":
				<path d="m4 17 6-6-6-6"></path><path d="M12 19h8"></path>
		}
	</svg>
}

templ Overview(page OverviewPage) {
	@layout("Dashboard", "dashboard") {
		<header class="dash-head">
			<div>
				<p class="eyebrow">DASHBOARD</p>
				<h1>
					if page.Started() {
						Welcome back
					} else {
						Ready when you are
					}
				</h1>
				<p class="muted">{ DateLabel(page.Today.Date) }</p>
			</div>
		</header>
		<section class="stats" aria-label="Your progress">
			<div><strong>{ Count(Summarize(page.Today.State).Attempted) }</strong><p>Problems attempted</p></div>
			<div><strong>{ Count(Summarize(page.Today.State).Solved) }</strong><p>Problems solved</p></div>
			<div><strong>{ page.IndependentRate() }</strong><p>Solved independently</p></div>
			<div><strong>{ Count(page.ActiveStreak()) }<span>{ DayUnit(page.ActiveStreak()) }</span></strong><p>Active days in a row</p></div>
		</section>
		@logAttemptForm(page.LogRef, page.LogError)
		<div class="dash-grid">
			<div>
				@todaysReviews(page.Today, page.IDs, "overview")
			</div>
			<div>
				@dueList(page.DueSoon(10), len(page.Due), page.Today)
				<section class="panel side-list" aria-labelledby="recent-title">
					<h2 id="recent-title">Recent attempts</h2>
					if recent := page.Recent(5); len(recent) > 0 {
						<ol>
							for _, a := range recent {
								<li>
									<a href={ templ.SafeURL(ProblemURL(a.ProblemSlug)) }>{ page.Today.State.Problem(a.ProblemSlug).DisplayTitle() }</a>
									<span class="small muted">{ OutcomeLabel(a.Outcome) } · { Count(a.Minutes) } min</span>
									if page.Today.State.StatedWrong(a.ID) {
										@complexityBadge()
									}
								</li>
							}
						</ol>
					} else {
						<p class="muted small">Your logged attempts will show up here.</p>
					}
				</section>
			</div>
		</div>
	}
}

// logAttemptForm opens any LeetCode problem's page in the app from its URL
// or slug; the problem page records the attempt.
templ logAttemptForm(ref string, message string) {
	<section class="panel log-problem" id="log-attempt" aria-labelledby="log-title">
		<h2 id="log-title">Log an attempt</h2>
		<p class="muted small">Paste a LeetCode problem link or slug, such as <code>two-sum</code>, to open its page and record an attempt.</p>
		<form class="log-problem-form" method="get" action="/leetgrinder/log">
			if message != "" {
				<p class="error" role="alert">{ message }</p>
			}
			<label>
				Problem
				<input type="text" name="problem" required maxlength="300" value={ ref } placeholder="https://leetcode.com/problems/two-sum/" autocomplete="off" spellcheck="false"/>
			</label>
			<button class="button primary" type="submit">Open problem</button>
		</form>
	</section>
}

// dueList is the optional list of due cards beyond today's plan.
templ dueList(cards []Card, total int, today Today) {
	<section class="panel side-list" aria-labelledby="due-title">
		<h2 id="due-title">Also due</h2>
		if total == 0 {
			<p class="muted small">Nothing else is due today.</p>
		} else {
			<p class="muted small">Optional: { Count(total) } more due by the end of today.</p>
			<ol>
				for _, c := range cards {
					<li>
						<a href={ templ.SafeURL(ProblemURL(c.Problem.Slug)) }>{ c.Problem.DisplayTitle() }</a>
						<span class="small muted">{ OutcomeLabel(c.Last.Outcome) } · recall { Percent(c.Retrievability(today.Now)) }</span>
					</li>
				}
			</ol>
			<a class="small" href="/leetgrinder/reviews">All reviews</a>
		}
	</section>
}

// problemMeta is the eyebrow line: number, difficulty and topics.
templ problemMeta(p Problem) {
	<p class="small muted problem-meta">
		if NumberLabel(p.Number) != "" {
			<span>{ NumberLabel(p.Number) }</span>
		}
		if p.Difficulty != "" {
			<span class={ DifficultyClass(p.Difficulty) }>{ p.Difficulty }</span>
		}
		for _, t := range p.Topics {
			<a class="topic-tag" href={ templ.SafeURL("/leetgrinder/problems?topic=" + t) }>{ TopicLabel(t) }</a>
		}
	</p>
}

// avail says whether the analysis worker is sending requests, and if not, why.
templ ProblemHistory(problem Problem, state State, form AttemptForm, avail AnalysisAvailability) {
	@layout(problem.DisplayTitle(), "") {
		<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/leetgrinder/problems">Problems</a><span>/</span><span>Attempt history</span></nav>
		@problemMeta(problem)
		<h1>
			{ problem.DisplayTitle() }
		</h1>
		if problem.NotFound {
			<p class="notice" role="status">Not found on LeetCode. Check the slug; attempts are kept either way.</p>
		} else if problem.Fetching() {
			<p class="muted small" role="status">Fetching details from LeetCode…</p>
		} else if !problem.InCatalog {
			<p class="muted small" role="status">Details load from LeetCode after you log an attempt.</p>
		}
		<div class="history-links">
			<a
				class="button"
				href={ templ.SafeURL(problem.URL()) }
				target="_blank"
				rel="noopener noreferrer"
			>Open on LeetCode ↗</a>
			<span class="badge">
				{ state.ProblemStatus(problem.Slug) }
			</span>
		</div>
		<div class="history-grid">
			<section class="panel">
				<h2>
					if form.Revision!="" {
						Correct your attempt
					} else {
						Record an attempt
					}
				</h2>@attemptFields(problem, form)
				if form.Error!="" && form.Revision!="" {
					<p>
						<a
							href={ templ.SafeURL(ProblemURL(problem.Slug)) }
						>Reload current history</a> before reapplying a conflicting correction. Your draft is shown above.
					</p>
				}
			</section>
			<section>
				@optimalPanel(problem, len(state.ProblemAttempts(problem.Slug)) > 0)
				<h2>Previous attempts</h2>
				if len(state.ProblemAttempts(problem.Slug))==0 {
					<p class="muted">No attempts recorded yet.</p>
				}
				for _, a:=range state.ProblemAttempts(problem.Slug) {
					<article class="panel attempt" id={ AttemptAnchor(a.ID) }>
						<div class="problem-heading">
							<h3>
								{ OutcomeLabel(a.Outcome) }
							</h3><span>{ Count(a.Minutes) } min</span>
						</div>
						<p class="small muted">
							<time datetime={ a.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>
								{ a.CreatedAt.UTC().Format("02 Jan 2006 · 15:04 UTC") }
							</time> ·
							if a.Assisted {
								Used solution help
							} else {
								No solution help
							}
							if a.IsReview {
								· Review
							}
						</p>
						@statedComplexity(a)
						if a.Notes!="" {
							<p class="notes">
								{ a.Notes }
							</p>
						}
						@attemptCode(a)
						@analysisCard(problem.Slug, a, state, avail)
						<details>
							<summary>Correct this attempt</summary>@attemptFields(problem, EditForm(a))
						</details>
					</article>
				}
			</section>
		</div>
	}
}

// optimalCell shows a problem's optimal time and space in the problems table.
templ optimalCell(p Problem) {
	if p.HasOptimal() {
		<span class="optimal-value"><abbr title="Time" aria-hidden="true">T</abbr><span class="visually-hidden">Time</span> { p.OptimalTime }</span>
		<span class="optimal-value"><abbr title="Space" aria-hidden="true">S</abbr><span class="visually-hidden">Space</span> { p.OptimalSpace }</span>
		if p.OptimalEstimated() {
			<span class="small muted estimate">Claude's estimate</span>
		}
	} else {
		<span class="muted" aria-hidden="true">—</span><span class="visually-hidden">Not known yet</span>
	}
}

// optimalPanel reveals the optimal complexity only once the learner has
// attempted the problem, so the answer's shape is not given away beforehand.
templ optimalPanel(p Problem, attempted bool) {
	<div class="panel optimal-panel">
		<h2>Optimal complexity</h2>
		if !attempted {
			<p class="small muted">The optimal time and space complexity appears after your first attempt.</p>
		} else if p.HasOptimal() {
			<dl>
				<dt>Optimal time</dt>
				<dd class="optimal-value">{ p.OptimalTime }</dd>
				<dt>Optimal space</dt>
				<dd class="optimal-value">{ p.OptimalSpace }</dd>
			</dl>
			if p.OptimalNote != "" {
				<p class="small muted">{ p.OptimalNote }</p>
			}
			if p.OptimalEstimated() {
				<p class="small muted">Claude's estimate from the first analysed attempt. Space excludes the returned output.</p>
			} else {
				<p class="small muted">Best-known bounds under the problem's constraints. Space excludes the returned output.</p>
			}
		} else {
			<p class="small muted">Not known yet. Claude estimates it when it analyses an attempt with captured code.</p>
		}
	</div>
}

// Retired is shown for pages of the retired 84-day curriculum.
templ Retired() {
	@layout("Page retired", "") {
		<section class="panel">
			<h1>This page was retired</h1>
			<p>The 84-day curriculum, with its day pages and lessons, has been replaced by a daily goal and reviews. Your attempts are all still here.</p>
			<p><a class="button primary" href="/leetgrinder">Go to the dashboard</a></p>
		</section>
	}
}

templ todaysReviews(today Today, ids map[string]string, ret string) {
	<section class="reviews" aria-labelledby="reviews-title">
		<p class="eyebrow">SPACED REPETITION</p>
		<h2 id="reviews-title">Today's review</h2>
		if len(today.Reviews) == 0 {
			<p class="muted">Nothing is due for review today. <a href="/leetgrinder/reviews">See all reviews</a></p>
		} else {
			<p class="muted">Re-solve each problem from scratch before looking at your old solution. <a href="/leetgrinder/reviews">All reviews</a></p>
			for _, item := range today.Reviews {
				@reviewCard(item, NewReviewForm(ids[ReviewKey(item.Problem.Slug)], ret))
			}
		}
	</section>
}

templ reviewCard(item ReviewItem, form AttemptForm) {
	<article class="problem-card review-card" id={ ReviewKey(item.Problem.Slug) }>
		<div class="problem-heading">
			<div>
				@problemMeta(item.Problem)
				<h3>
					<a
						href={ templ.SafeURL(item.Problem.URL()) }
						target="_blank"
						rel="noopener noreferrer"
					>{ item.Problem.DisplayTitle() } <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span></a>
				</h3>
			</div>
			if item.Done {
				<span class="badge done">Reviewed today</span>
			} else {
				<span class="badge">Review</span>
			}
		</div>
		if item.Reason != "" {
			<p class="reason">{ item.Reason }</p>
		}
		<div class="problem-actions">
			<a href={ templ.SafeURL(ProblemURL(item.Problem.Slug)) }>Attempt history</a>
		</div>
		if !item.Done && form.ID != "" {
			<details class="log-attempt">
				<summary>Record your review</summary>@attemptFields(item.Problem, form)
			</details>
		}
	</article>
}

templ Reviews(page ReviewsPage) {
	@layout("Reviews", "reviews") {
		<p class="eyebrow">SPACED REPETITION</p>
		<h1>Reviews</h1>
		<p class="lead">Every problem you have attempted, scheduled by how likely you are to recall it.</p>
		<section class="stats" aria-label="Review summary">
			<div><strong>{ Count(len(page.Today.Reviews)) }</strong><p>Planned today</p></div>
			<div><strong>{ Count(page.Today.Backlog(page.Cards)) }</strong><p>Due but not planned</p></div>
			<div><strong>{ Count(len(page.Cards)) }</strong><p>Problems tracked</p></div>
			<div><strong>{ Count(ReviewSlots(page.Today.Settings.DailyHours)) }</strong><p>Review slots today</p></div>
		</section>
		@todaysReviews(page.Today, page.IDs, "reviews")
		<section class="queue" aria-labelledby="queue-title">
			<h2 id="queue-title">All cards</h2>
			if len(page.Cards) == 0 {
				<p class="muted">Record an attempt on any problem to start its review schedule.</p>
			} else {
				<div class="table-scroll">
					<table>
						<thead><tr><th scope="col">Problem</th><th scope="col">Last counted attempt</th><th scope="col">Due</th><th scope="col">Recall now</th></tr></thead>
						<tbody>
							for _, card := range page.Cards {
								<tr>
									<td><a href={ templ.SafeURL(ProblemURL(card.Problem.Slug)) }>{ card.Problem.DisplayTitle() }</a></td>
									<td>{ OutcomeLabel(card.Last.Outcome) } · { DateLabel(Date(card.Last.CreatedAt, page.Today.Settings.Location())) }</td>
									<td>{ DateLabel(Date(card.Due, page.Today.Settings.Location())) }</td>
									<td>{ Percent(card.Retrievability(page.Today.Now)) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

templ SettingsView(page SettingsPage) {
	@layout("Settings", "settings") {
		<h1>Settings</h1>
		if page.Error != "" {
			<p class="error" role="alert">{ page.Error }</p>
		}
		if page.Saved {
			<p class="notice" role="status">Settings saved.</p>
		}
		<div class="settings-sections">
			@generalSettings(page)
			@notifySettings(page.Notify)
			@analysisSettings(page.Analysis)
			@apiTokenSettings(page)
		</div>
	}
}

templ generalSettings(page SettingsPage) {
	<section class="panel" id="general" aria-labelledby="general-settings-title">
		<h2 id="general-settings-title">General</h2>
		<form class="attempt-form settings-form" method="post" action="/leetgrinder/settings/general">
			<input type="hidden" name="revision" value={ page.General.Revision }/>
			<div class="form-row">
				<label>
					Time zone
					<input type="text" name="timezone" list="timezones" required value={ page.General.Timezone } autocomplete="off" spellcheck="false"/>
				</label>
				<label>
					Daily time
					<select name="hours" required>
						for _, h := range HoursOptions() {
							<option value={ HoursValue(h) } selected?={ page.General.Hours == HoursValue(h) }>{ HoursLabel(h) } · { ReviewSlotsLabel(ReviewSlots(h)) }</option>
						}
					</select>
				</label>
			</div>
			<datalist id="timezones">
				for _, tz := range timezoneSuggestions {
					<option value={ tz }></option>
				}
			</datalist>
			<p class="small muted">Days, reviews and reminders follow this time zone. Two hours gives one review a day; every extra 25 minutes adds a review slot.</p>
			<button class="button primary" type="submit">Save</button>
		</form>
	</section>
}

templ Problems(page ProblemsPage) {
	@layout("Problems", "problems") {
		<p class="eyebrow">PROBLEMS</p>
		<h1>Problems</h1>
		<p class="lead">Every LeetCode problem you have attempted. Search by title, LeetCode number, or topic, and filter by difficulty, topic, or your progress.</p>
		<form class="problem-filters" method="get" action="/leetgrinder/problems" role="search" aria-label="Filter problems">
			<label class="filter-search">
				Search
				<input type="search" name="q" value={ page.Filter.Query } maxlength="100" placeholder="Title, number, or topic" autocomplete="off"/>
			</label>
			<label>
				Difficulty
				<select name="difficulty">
					<option value="">All</option>
					for _, d := range []string{"Easy", "Medium", "Hard"} {
						<option value={ d } selected?={ page.Filter.Difficulty == d }>{ d }</option>
					}
				</select>
			</label>
			<label>
				Topic
				<select name="topic">
					<option value="">All topics</option>
					for _, t := range page.Topics {
						<option value={ t.Key } selected?={ page.Filter.Topic == t.Key }>{ t.Label }</option>
					}
				</select>
			</label>
			<label>
				Status
				<select name="status">
					<option value="">Any</option>
					for _, s := range ProblemStatusOptions() {
						<option value={ s.Key } selected?={ page.Filter.Status == s.Key }>{ s.Label }</option>
					}
				</select>
			</label>
			<label>
				Sort
				<select name="sort">
					for _, s := range ProblemSortOptions() {
						<option value={ s.Key } selected?={ page.Filter.Sort == s.Key }>{ s.Label }</option>
					}
				</select>
			</label>
			<div class="filter-actions">
				<button class="button primary" type="submit">Apply</button>
				if page.Filter.Active() {
					<a href="/leetgrinder/problems">Clear filters</a>
				}
			</div>
		</form>
		<p class="small muted" role="status">Showing { Count(len(page.Rows)) } of { Count(page.Total) } problems</p>
		if page.Total == 0 {
			<p class="panel muted">No attempts yet. <a href="/leetgrinder#log-attempt">Log an attempt</a> on any LeetCode problem to see it here.</p>
		} else if len(page.Rows) == 0 {
			<p class="panel muted">No problems match these filters. <a href="/leetgrinder/problems">Clear filters</a></p>
		} else {
			<div class="table-scroll queue problem-table">
				<table>
					<caption class="visually-hidden">Attempted problems</caption>
					<thead>
						<tr>
							<th scope="col">#</th>
							<th scope="col">Problem</th>
							<th scope="col">Difficulty</th>
							<th scope="col">Topics</th>
							<th scope="col">Optimal time / space</th>
							<th scope="col">Status</th>
							<th scope="col">Attempts</th>
							<th scope="col">Last attempt</th>
							<th scope="col">Next due</th>
							<th scope="col">LeetCode</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range page.Rows {
							<tr>
								<td class="num">
									if row.Problem.Number > 0 {
										{ Count(row.Problem.Number) }
									}
								</td>
								<th scope="row">
									<a href={ templ.SafeURL(ProblemURL(row.Problem.Slug)) }>{ row.Problem.DisplayTitle() }</a>
									if row.Problem.NotFound {
										<span class="small muted">Not found on LeetCode</span>
									}
								</th>
								<td>
									if row.Problem.Difficulty != "" {
										<span class={ DifficultyClass(row.Problem.Difficulty) }>{ row.Problem.Difficulty }</span>
									}
								</td>
								<td class="topic">
									for _, t := range row.Problem.Topics {
										<span class="small">{ TopicLabel(t) }</span>
									}
								</td>
								<td class="optimal">@optimalCell(row.Problem)
</td>
								<td>
									<span class={ StatusClass(row.Status) }>{ row.Status }</span>
									if row.Due {
										<span class="badge">Due</span>
									}
									if row.ComplexityWrong {
										@complexityBadge()
									}
								</td>
								<td class="num">{ Count(row.Attempts) }</td>
								<td>{ DateLabel(Date(row.Last.CreatedAt, page.Location)) }</td>
								<td>
									if row.Card.Reviews > 0 {
										{ DateLabel(Date(row.Card.Due, page.Location)) }
									}
								</td>
								<td>
									<a href={ templ.SafeURL(row.Problem.URL()) } target="_blank" rel="noopener noreferrer">Open<span aria-hidden="true"> ↗</span><span class="visually-hidden"> { row.Problem.DisplayTitle() } on LeetCode (opens in a new tab)</span></a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ attemptFields(problem Problem, form AttemptForm) {
	<form class="attempt-form" method="post" action={ templ.SafeURL(ProblemURL(problem.Slug) + "/attempts") }>
		<input type="hidden" name="id" value={ form.ID }/><input type="hidden" name="revision" value={ form.Revision }/>
		if form.Review {
			<input type="hidden" name="review" value="true"/>
		}
		if form.Return != "" {
			<input type="hidden" name="return" value={ form.Return }/>
		}
		if form.Error!="" {
			<p class="error" role="alert">
				{ form.Error }
			</p>
		}
		<div class="form-row"><label>Outcome<select name="outcome" required><option value="unfinished" selected?={ form.Outcome=="unfinished" }>Unfinished</option><option value="struggled" selected?={ form.Outcome=="struggled" }>Struggled</option><option value="solved" selected?={ form.Outcome=="solved" }>Solved</option></select></label><label>Minutes spent<input type="number" name="minutes" min="1" max="240" required value={ form.Minutes }/></label></div>
		<fieldset class="complexity">
			<legend>Complexity <span class="muted">(required when solved or struggled)</span></legend>
			<div class="form-row">
				@complexityField("timeComplexity", "time", form.Time)
				@complexityField("spaceComplexity", "space", form.Space)
			</div>
		</fieldset>
		<label class="checkbox"><input type="checkbox" name="assisted" value="true" checked?={ form.Assisted }/>I used hints or reviewed a solution</label>
		<label>
			Notes <span class="muted">(optional)</span>
			<textarea name="notes" rows="3" maxlength="2000" placeholder="What worked? Where did you get stuck?">
				{ form.Notes }
			</textarea>
		</label>
		<p class="small muted">Solved means your solution passed on LeetCode. Mark help even if you wrote the final code yourself.</p>
		<button class="button primary" type="submit">
			if form.Revision!="" {
				Save correction
			} else {
				Save attempt
			}
		</button>
	</form>
}

// complexityField is a select of common classes plus a text field for any
// other value. It works without JavaScript; complexityScript only hides the
// text field until "Other…" is chosen.
templ complexityField(name string, label string, input ComplexityInput) {
	<div class="complexity-field" data-complexity>
		<label>
			<span class="capitalize">{ label }</span>
			<select name={ name }>
				<option value="" selected?={ input.Choice=="" }>Not stated</option>
				for _, c := range Complexities {
					<option value={ c } selected?={ input.Choice==c }>{ c }</option>
				}
				<option value="other" selected?={ input.Choice=="other" }>Other…</option>
			</select>
		</label>
		<label class="complexity-other">
			Other { label } complexity
			<input type="text" name={ name + "Other" } maxlength="40" placeholder="O(m·n)" autocomplete="off" spellcheck="false" value={ input.Other }/>
		</label>
	</div>
}

templ complexityScript() {
	<script>
		(() => {
			const sync = (select) => {
				const other = select.closest("[data-complexity]").querySelector(".complexity-other");
				const show = select.value === "other";
				other.hidden = !show;
				other.querySelector("input").disabled = !show;
			};
			document.querySelectorAll("[data-complexity] select").forEach(sync);
			document.addEventListener("change", (event) => {
				if (event.target instanceof HTMLSelectElement && event.target.closest("[data-complexity]")) sync(event.target);
			});
		})();
	</script>
}

templ statedComplexity(a Attempt) {
	if a.TimeComplexity != "" || a.SpaceComplexity != "" {
		<p class="small stated-complexity">
			Time <strong>{ orDash(a.TimeComplexity) }</strong> · Space <strong>{ orDash(a.SpaceComplexity) }</strong>
		</p>
	}
}

templ attemptCode(a Attempt) {
	if a.Code != "" {
		<details class="attempt-code">
			<summary>Submitted code ({ LanguageLabel(a.CodeLanguage) }, { ByteSize(len(a.Code)) })</summary>
			<pre><code data-language={ a.CodeLanguage }>{ a.Code }</code></pre>
		</details>
	}
}

templ Unavailable(message string) {
	@layout("Unable to load", "") {
		<section class="panel">
			<h1>Unable to load your progress</h1>
			<p role="alert">
				{ message }
			</p>
			<p><a href="/leetgrinder">Try again</a></p>
		</section>
	}
}
