package leetgrinder

import (
	"strings"
	"time"

	"github.com/michael-duren/career-strategy/internal/shell"
	"github.com/michael-duren/career-strategy/internal/timefmt"
)

// layout is every Leetgrinder page: the app header, the sub-tabs and the page.
// The theme-init script runs before first paint and before the stylesheets, like
// ThemeHead.astro: it swaps the default for the saved theme (src/lib/theme.ts;
// tests/fonts.test.ts keeps the two in sync).
templ layout(title string, active string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="description" content="Track LeetCode practice with a daily goal and spaced-repetition reviews."/>
			<title>{ title } · Leetgrinder</title>
			<script id="theme-init">
				(function () {
					var themes = ["dark", "vellum", "cobalt", "concrete"];
					var saved = null;
					try {
						saved = localStorage.getItem("career-theme");
					} catch (e) {}
					document.documentElement.dataset.theme = themes.indexOf(saved) >= 0 ? saved : "dark";
				})();
			</script>
			<link rel="icon" href="/favicon.svg"/>
			<link rel="stylesheet" href="/ui/fonts.css"/>
			@shell.Head()
			<link rel="stylesheet" href="/leetgrinder/style.css"/>
		</head>
		<body>
			<a class="skip" href="#main">Skip to content</a>
			@shell.Header("leetgrinder")
			<div class="lg-page">
				<nav class="lg-tabs" aria-label="Leetgrinder">
					@navLink("/leetgrinder", "Today", "dashboard", active)
					@navLink("/leetgrinder/reviews", "Reviews", "reviews", active)
					@navLink("/leetgrinder/todos", "Sets", "todos", active)
					@navLink("/leetgrinder/log", "Log", "log", active)
					@navLink("/leetgrinder/problems", "Problems", "problems", active)
					@navLink("/leetgrinder/stats", "Stats", "stats", active)
					@navLink("/leetgrinder/settings", "Settings", "settings", active)
					<a class="lg-tabs-export" href="/leetgrinder/export">
						@icon("download")
						<span>Export</span>
					</a>
				</nav>
				<main id="main">
					{ children... }
				</main>
			</div>
			@complexityScript()
			@copyScript()
			@tabsScript()
		</body>
	</html>
}

// navLink is one Leetgrinder sub-tab; the current one carries aria-current.
templ navLink(href string, label string, key string, active string) {
	if key == active {
		<a href={ templ.SafeURL(href) } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) }>{ label }</a>
	}
}

// icon draws thin line icons inline so pages need no icon font.
templ icon(name string) {
	<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
		switch name {
			case "download":
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path>
			case "warning":
				<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path>
			case "about":
				<circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path>
		}
	</svg>
}

// Overview is the Today page (docs/redesign/pages/leetgrinder.md): streak and
// today's goal with the review picks, weekly solves and rates, and the weakest
// topics, then the practice queue and the optional due list.
templ Overview(page OverviewPage) {
	@layout("Today", "dashboard") {
		{{ d := page.Dashboard() }}
		<div class="lg-today">
			<section class="lg-today-goal" aria-labelledby="streak-title">
				@streakHead(page.Today, d)
				@goalTable(page.Today)
				@newPicks(page.Today)
				@todaysReviews(page.Today, page.IDs, "overview")
			</section>
			<section class="lg-today-trends" aria-labelledby="weekly-title">
				@weeklyChart(d)
				@recentRates(d)
				@difficultyMix(d)
			</section>
			<aside class="lg-today-topics" aria-labelledby="weak-title">
				@weakestTopics(d)
			</aside>
		</div>
		<div class="lg-today-more">
			@nextTodos(page.NextTodos)
			@dueList(page.Today, 10)
		</div>
	}
}

// streakHead is the big streak number over a tick scale from 0 to the record.
templ streakHead(today Today, d Dashboard) {
	<h1 class="lg-streak" id="streak-title">
		<span class="lg-streak-num">{ StreakLabel(today.Streaks.Current) }</span>
		<span class="lg-streak-text">
			<span class="lg-streak-unit">Day streak</span>
			<span class="ui-label">
				Record { Count(today.Streaks.Longest) } ·
				if today.Progress.Met() {
					goal met ✓
				} else {
					{ Count(today.Progress.Remaining()) } to go
				}
			</span>
		</span>
	</h1>
	<div class="ui-ticks lg-streak-ticks" aria-hidden="true">
		for _, t := range d.Ticks {
			<span class={ "ui-ticks__tick", templ.KV("ui-ticks__tick--major", t.Major), templ.KV("ui-ticks__tick--on", t.On) }></span>
		}
	</div>
	<p class="lg-scale ui-label" aria-hidden="true"><span>0</span><span>Days</span><span>{ Count(d.TickMax) }</span></p>
	<p class="visually-hidden">{ Count(today.Streaks.Current) } { DayUnit(today.Streaks.Current) } in a row, longest { Count(today.Streaks.Longest) }, { Count(today.Streaks.Active) } active { DayUnit(today.Streaks.Active) } in a row.</p>
}

// goalTable is today's goal: done against target for new problems and
// reviews, the quick reviews and bonus, and what is still due. Phones show
// the same numbers as a row of counts.
templ goalTable(today Today) {
	<table class="lg-goal">
		<caption class="ui-label">
			Today's goal · { GoalLabel(today.Progress.Target()) } ·
			if today.Progress.Met() {
				Goal met
			} else {
				{ Count(today.Progress.Remaining()) } to go
			}
		</caption>
		<thead><tr><th scope="col">Type</th><th scope="col">Done</th><th scope="col">Goal</th></tr></thead>
		<tbody>
			<tr class={ templ.KV("done", today.Progress.NewLeft() == 0) }><th scope="row">New</th><td>{ Count(today.Progress.New()) }</td><td>{ Count(today.Goal.New) }</td></tr>
			<tr class={ templ.KV("done", today.Progress.ReviewsLeft() == 0) }><th scope="row">Review</th><td>{ Count(today.Progress.Reviews()) }</td><td>{ Count(today.Progress.ReviewTarget()) }</td></tr>
			<tr><th scope="row">Quick / bonus</th><td>{ Count(today.QuickReviews) } / { Count(today.Progress.Bonus()) }</td><td>—</td></tr>
			<tr><th scope="row">Still due</th><td>{ Count(today.Backlog()) }</td><td>—</td></tr>
		</tbody>
	</table>
	<dl class="lg-counts" aria-hidden="true">
		<div><dt class="ui-label">New</dt><dd>{ Count(today.Progress.New()) }/{ Count(today.Goal.New) }</dd></div>
		<div><dt class="ui-label">Review</dt><dd>{ Count(today.Progress.Reviews()) }/{ Count(today.Progress.ReviewTarget()) }</dd></div>
		<div><dt class="ui-label">Quick/bonus</dt><dd>{ Count(today.QuickReviews) }/{ Count(today.Progress.Bonus()) }</dd></div>
		<div><dt class="ui-label">Due</dt><dd>{ Count(today.Backlog()) }</dd></div>
	</dl>
	if !today.Progress.Met() && today.Progress.NewLeft() == 0 && today.Progress.ReviewsLeft() == 0 {
		<p class="small muted">Log any attempt to meet today's goal.</p>
	}
}

// weeklyChart draws solved problems per week as hatched columns, the
// current (partial) week dashed, with guide lines and the pace note.
templ weeklyChart(d Dashboard) {
	<h2 class="ui-section-header__title" id="weekly-title">Solved per week</h2>
	if len(d.Weeks) == 0 {
		<p class="small muted">Weekly columns appear after your first attempt.</p>
	} else {
		<div class="lg-weeks">
			<div class="lg-weeks-plot" role="list" aria-label={ "Problems solved per week, last " + Count(len(d.Weeks)) + " weeks" }>
				<div class="lg-guides" aria-hidden="true">
					for _, g := range d.Guides {
						<span class="lg-guide" style={ "bottom: " + g.Bottom }><span class="ui-label">{ Count(g.Value) }</span></span>
					}
				</div>
				for _, w := range d.Weeks {
					<div class="lg-week" role="listitem" title={ w.Title }>
						<span class="lg-week-n" aria-hidden="true">{ Count(w.Solved) }</span>
						<span class={ "lg-week-bar", templ.KV("ui-hatch--diagonal", !w.Current), templ.KV("lg-week-bar--current", w.Current) } style={ "height: " + w.Height } aria-hidden="true"></span>
						<span class="visually-hidden">
							{ w.Title }
							if w.Current {
								(this week so far)
							}
						</span>
					</div>
				}
				if d.Pace != "" {
					<p class="ui-note lg-pace" title={ d.PaceTitle }>{ d.Pace }<span class="lg-pace-counts" aria-hidden="true"> · { d.PaceCounts }</span><span class="visually-hidden">: { d.PaceTitle }</span></p>
				}
			</div>
			<div class="lg-weeks-labels" aria-hidden="true">
				for _, w := range d.Weeks {
					<span class="ui-label">{ w.Label }</span>
				}
			</div>
			<div class="lg-dim-caption">
				<span class="ui-dim"></span>
				<span class="ui-label">{ Count(len(d.Weeks)) } { plural(len(d.Weeks), "week", "weeks") } · { Count(d.Solved) } solved</span>
				<span class="ui-dim"></span>
			</div>
		</div>
	}
}

// recentRates are the shown weeks' independent-solve share, complexity
// checks right, and average minutes on a medium problem.
templ recentRates(d Dashboard) {
	<dl class="lg-rates">
		<div><dt class="ui-label">Independent</dt><dd>{ d.Independent }</dd></div>
		<div><dt class="ui-label">Complexity ok</dt><dd>{ d.Complexity }</dd></div>
		<div><dt class="ui-label">Avg medium</dt><dd>{ d.AvgMedium }</dd></div>
	</dl>
}

// difficultyMix is each difficulty's solved share of attempted problems,
// all time, as a hatch fill on a measurement line.
templ difficultyMix(d Dashboard) {
	if len(d.Difficulties) > 0 {
		<h2 class="ui-section-header__title lg-difficulty-title" id="difficulty-title">Difficulty</h2>
		<ul class="lg-difficulty" aria-labelledby="difficulty-title">
			for _, x := range d.Difficulties {
				<li>
					<span class="lg-difficulty-name">{ x.Name }</span>
					<span class="ui-progress" aria-hidden="true"><span class="ui-progress__fill ui-hatch--diagonal" style={ "width: " + x.Width }></span><span class="ui-dim"></span></span>
					<span class="lg-difficulty-value">{ x.Label }<span class="visually-hidden"> solved</span></span>
				</li>
			}
		</ul>
	}
}

// weakestTopics lists the topics with the lowest average recall, marking
// low recall and high struggle, and offers a todo set built from them.
templ weakestTopics(d Dashboard) {
	<h2 class="ui-section-header__title" id="weak-title">Weakest topics</h2>
	if len(d.Topics) == 0 {
		<p class="small muted">Topics with at least { Count(MinTopicProblems) } attempted problems show up here, weakest recall first.</p>
	} else {
		<table class="lg-topics">
			<caption class="visually-hidden">Weakest topics by average recall</caption>
			<thead><tr><th scope="col">Topic</th><th scope="col" class="lg-topics-qty"><abbr title="Problems attempted">Qty</abbr></th><th scope="col">Recall</th><th scope="col"><abbr title="Struggle rate">Strug.</abbr></th></tr></thead>
			<tbody>
				for _, t := range d.Topics {
					<tr>
						<th scope="row"><a href={ templ.SafeURL("/leetgrinder/problems?topic=" + t.Key) }>{ t.Label }</a></th>
						<td class="lg-topics-qty">{ Count(t.Problems) }</td>
						<td class={ templ.KV("lg-weak", t.WeakRecall) }>
							{ Percent(t.Recall) }
							if t.WeakRecall {
								<span class="visually-hidden">, below 80%</span>
							}
						</td>
						<td class={ templ.KV("lg-weak", t.WeakStruggle) }>
							{ Percent(t.Struggle) }
							if t.WeakStruggle {
								<span class="visually-hidden">, above 55%</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p class="ui-label lg-topics-key">Sorted by recall · accent = below 80% or struggle above 55%</p>
		if len(d.BuildProblems) > 0 {
			<form class="lg-build" method="get" action="/leetgrinder/todos/sets/new">
				<input type="hidden" name="title" value={ d.BuildTitle }/>
				<input type="hidden" name="problems" value={ strings.Join(d.BuildProblems, "\n") }/>
				<button class="ui-btn" type="submit">Build todo set from top { Count(min(BuildSetTopics, len(d.Topics))) }</button>
				<p class="small muted">Opens a new set with the lowest-recall problem from each topic, for you to check and save.</p>
			</form>
		}
	}
}

// nextTodos shows the next five todo problems below today's work, so the
// queue reads as part of the day.
templ nextTodos(items []TodoItem) {
	<section class="next-todos" aria-labelledby="next-todos-title">
		<div class="ui-section-header ui-section-header--rule">
			<h2 class="ui-section-header__title" id="next-todos-title">Next 5 todo problems</h2>
			<a class="ui-label ui-section-header__meta" href="/leetgrinder/todos">All sets</a>
		</div>
		if len(items) == 0 {
			<p class="muted">No todo problems yet. <a href="/leetgrinder/todos/add">Add a problem</a> to start your queue.</p>
		} else {
			<p class="small muted">The oldest problems still to do across your todos.</p>
			<ol class="todo-cards">
				for i, item := range items {
					<li class={ "todo-card", templ.KV("todo-card-first", i == 0) }>
						<span class="todo-card-rank" aria-hidden="true">{ StreakLabel(i + 1) }</span>
						<div class="todo-card-body">
							<p class="todo-card-meta">
								if item.Problem.Number > 0 {
									<span>#{ Count(item.Problem.Number) }</span>
								}
								if item.Problem.Difficulty != "" {
									<span class={ DifficultyClass(item.Problem.Difficulty) }>{ item.Problem.Difficulty }</span>
								}
								if item.SetTitle != "" {
									<span class="todo-card-set">{ item.SetTitle }</span>
								} else if item.SetID == "" {
									<span class="todo-card-set">Individual</span>
								}
							</p>
							<h3><a href={ templ.SafeURL(ProblemURL(item.Problem.Slug)) }>{ item.Problem.DisplayTitle() }</a></h3>
							if len(item.Problem.Topics) > 0 {
								<p class="row-topics">
									for j, topic := range item.Problem.Topics {
										if j < 3 {
											<span class="topic-tag">{ item.Problem.TopicLabel(topic) }</span>
										}
									}
									if len(item.Problem.Topics) > 3 {
										<span class="small muted">+{ Count(len(item.Problem.Topics) - 3) }</span>
									}
								</p>
							}
						</div>
						<div class="problem-site-links">
							<a class={ "button", templ.KV("primary", i == 0) } href={ templ.SafeURL(item.Problem.URL()) } target="_blank" rel="noopener noreferrer">Solve<span aria-hidden="true"> ↗</span><span class="visually-hidden"> { item.Problem.DisplayTitle() } on { item.Problem.Site() } (opens in a new tab)</span></a>
							@neetcodeLink(item.Problem, "button")
						</div>
					</li>
				}
			</ol>
		}
	</section>
}

// LogView is the LOG tab: open any problem's page to record an attempt, the
// latest attempts, and all-time totals.
templ LogView(page LogPage) {
	@layout("Log an attempt", "log") {
		<header class="dash-head"><div><p class="eyebrow">Log</p><h1>Log an attempt</h1></div></header>
		<div class="dash-grid">
			<div>
				@logAttemptForm(page.Ref, page.Error)
				<section class="side-list" aria-labelledby="recent-title">
					<div class="ui-section-header ui-section-header--rule">
						<h2 class="ui-section-header__title" id="recent-title">Recent attempts</h2>
						<a class="ui-label ui-section-header__meta" href="/leetgrinder/problems">All problems</a>
					</div>
					if recent := page.Recent(LogRecent); len(recent) > 0 {
						<ol>
							for _, a := range recent {
								<li>
									<a href={ templ.SafeURL(ProblemURL(a.ProblemSlug)) }>{ page.Today.State.Problem(a.ProblemSlug).DisplayTitle() }</a>
									<span class="small muted">
										{ AttemptLabel(a) } · { Count(a.Minutes) } min · { timefmt.Date(Date(a.CreatedAt, page.Today.Settings.Location())) }
										if kind := page.Today.KindOf(a); kind != KindNew && kind != "" {
											· { KindLabel(kind) }
										}
									</span>
									if page.Today.State.StatedWrong(a.ID) {
										@complexityBadge()
									}
								</li>
							}
						</ol>
					} else {
						<p class="muted small">Your logged attempts will show up here.</p>
					}
				</section>
			</div>
			<div>
				@progressPanel(page.OverviewPage)
			</div>
		</div>
	}
}

// logAttemptForm opens any LeetCode problem's page in the app from its URL
// or slug; the problem page records the attempt.
templ logAttemptForm(ref string, message string) {
	<section class="panel log-problem" id="log-attempt" aria-labelledby="log-title">
		<h2 id="log-title">Open a problem</h2>
		<p class="muted small">Paste a LeetCode or NeetCode problem link, or a LeetCode slug such as <code>two-sum</code>, to open its page and record an attempt.</p>
		<form class="log-problem-form" method="get" action="/leetgrinder/log">
			if message != "" {
				<p class="error" role="alert">{ message }</p>
			}
			<label class="ui-field">
				<span class="ui-label">Problem</span>
				<input class="ui-field__input" type="text" name="problem" required maxlength="300" value={ ref } placeholder="https://leetcode.com/problems/two-sum/" autocomplete="off" spellcheck="false"/>
			</label>
			<button class="button primary" type="submit">Open problem</button>
		</form>
	</section>
}

// newPicks lists today's new problems picked from todos. While the new
// target is open it names the next pick, or explains a short or failed plan.
templ newPicks(today Today) {
	if open := today.Progress.NewLeft() > 0; len(today.NewPicks) > 0 || (open && (today.NewPicksShort() || today.NewPicksFailed)) {
		<div class="new-picks">
			if next, ok := today.NextNewPick(); ok && open {
				<p class="small">
					Next new problem: <a href={ templ.SafeURL(ProblemURL(next.Problem.Slug)) }>{ next.Problem.DisplayTitle() }</a>
					if next.SetTitle != "" {
						from { next.SetTitle }
					}
				</p>
			} else if !ok && len(today.NewPicks) > 0 {
				if open {
					<p class="small muted">Today's picked new problems are done. Any other new problem counts toward the goal.</p>
				} else {
					<p class="small muted">Today's picked new problems are done.</p>
				}
			}
			if len(today.NewPicks) > 0 {
				<ol class="small" aria-label="Today's new problems from todos">
					for _, pick := range today.NewPicks {
						<li class={ templ.KV("done", pick.Done) }>
							<a href={ templ.SafeURL(ProblemURL(pick.Problem.Slug)) }>{ pick.Problem.DisplayTitle() }</a>
							if pick.Done {
								<span class="muted">· done</span>
							}
							if pick.SetTitle != "" {
								<span class="muted">· { pick.SetTitle }</span>
							}
						</li>
					}
				</ol>
			}
			if open && today.NewPicksFailed {
				<p class="small muted">Today's new problems could not be picked from your todos just now. They are picked on your next visit.</p>
			} else if open && today.NewPicksShort() {
				<p class="small muted">Fewer todos than today's new target could be picked. Todos already done, or attempted on an earlier day, are skipped; <a href="/leetgrinder/todos/add">add todos</a> and they are picked on your next visit today.</p>
			}
		</div>
	}
}

// progressPanel is the all-time summary.
templ progressPanel(page OverviewPage) {
	<section class="side-list" aria-labelledby="progress-title">
		<div class="ui-section-header ui-section-header--rule">
			<h2 class="ui-section-header__title" id="progress-title">All time</h2>
		</div>
		<dl class="summary">
			<dt>Problems attempted</dt>
			<dd>{ Count(Summarize(page.Today.State).Attempted) }</dd>
			<dt>Problems solved</dt>
			<dd>{ Count(Summarize(page.Today.State).Solved) }</dd>
			<dt>Solved independently</dt>
			<dd>{ page.IndependentRate() }</dd>
			<dt>Longest streak</dt>
			<dd>{ Count(page.Today.Streaks.Longest) } { DayUnit(page.Today.Streaks.Longest) }</dd>
		</dl>
	</section>
}

// dueList is the optional list of due cards beyond today's plan.
templ dueList(today Today, n int) {
	{{ cards, total := DueSoon(today, n) }}
	<section class="side-list" aria-labelledby="due-title">
		<div class="ui-section-header ui-section-header--rule">
			<h2 class="ui-section-header__title" id="due-title">Also due</h2>
			<a class="ui-label ui-section-header__meta" href="/leetgrinder/reviews">All reviews</a>
		</div>
		if total == 0 {
			<p class="muted small">Nothing else is due today.</p>
		} else {
			<p class="muted small">Optional: { Count(total) } more due by the end of today. They count toward the review goal and as bonus.</p>
			<ol>
				for _, c := range cards {
					<li>
						<a href={ templ.SafeURL(ProblemURL(c.Problem.Slug)) }>{ c.Problem.DisplayTitle() }</a>
						if c.Flag != nil {
							<span class="small flag">{ c.Flag.Label() }</span>
						} else {
							<span class="small muted">{ AttemptLabel(c.Last) } · recall { Percent(c.Retrievability(today.Now)) }</span>
						}
					</li>
				}
			</ol>
		}
	</section>
}

// problemMeta is the eyebrow line: number, difficulty and topics.
templ problemMeta(p Problem) {
	<p class="small muted problem-meta">
		if NumberLabel(p.Number) != "" {
			<span>{ NumberLabel(p.Number) }</span>
		}
		if p.Difficulty != "" {
			<span class={ DifficultyClass(p.Difficulty) }>{ p.Difficulty }</span>
		}
		for _, t := range p.Topics {
			<a class="topic-tag" href={ templ.SafeURL("/leetgrinder/problems?topic=" + t) }>{ p.TopicLabel(t) }</a>
		}
	</p>
}

// avail says whether the analysis worker is sending requests, and if not, why.
templ ProblemHistory(problem Problem, state State, form AttemptForm, avail AnalysisAvailability, review ProblemReview) {
	@layout(problem.DisplayTitle(), "") {
		<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/leetgrinder/problems">Problems</a><span>/</span><span>Attempt history</span></nav>
		@problemMeta(problem)
		<h1>
			{ problem.DisplayTitle() }
		</h1>
		if problem.NotFound {
			<p class="notice" role="status">Not found on LeetCode. Check the slug; attempts are kept either way.</p>
		} else if problem.Fetching() {
			<p class="muted small" role="status">Fetching details from LeetCode…</p>
		} else if !problem.InCatalog && !IsNeetCodeOnly(problem.Slug) {
			<p class="muted small" role="status">Details load from LeetCode after you log an attempt.</p>
		}
		<div class="history-links">
			<a
				class="button"
				href={ templ.SafeURL(problem.URL()) }
				target="_blank"
				rel="noopener noreferrer"
			>Open on { problem.Site() } ↗</a>
			@neetcodeLink(problem, "button")
			{{ latest, best := state.ProblemLatest(problem.Slug), state.ProblemBest(problem.Slug) }}
			if latest != ResultNone {
				<span class="status-group">
					<span class="small muted">Latest</span>
					<span class={ StatusClass(latest) }>{ latest }</span>
				</span>
			}
			if ShowBest(best, latest) {
				<span class="status-group">
					<span class="small muted">Best</span>
					<span class={ StatusClass(best) }>{ best }</span>
				</span>
			}
			if review.Pick {
				<span class="badge">Today's review</span>
			} else if review.Due {
				<span class="badge">Due for review</span>
			}
		</div>
		if review.Card.Reviews > 0 {
			<dl class="review-state">
				<dt>Recall now</dt>
				<dd>{ Percent(review.Recall) }</dd>
				<dt>Next due</dt>
				if review.Card.Reviewable() || review.Due {
					<dd>{ DateLabel(Date(review.Card.Due, review.Location)) }</dd>
				} else {
					<dd>Not scheduled</dd>
				}
			</dl>
			if review.FlagReason != "" {
				<p class="flag" role="status">{ review.FlagReason }</p>
			}
		}
		{{ attempts := state.ProblemAttempts(problem.Slug) }}
		<div class="tabs" data-tabs={ HistoryTab(form, len(attempts) > 0) }>
			<div class="tab-list" role="tablist" aria-label="Problem sections" hidden>
				@historyTabButton("attempts", "Attempts", len(attempts))
				@historyTabButton("record", RecordTabLabel(form), -1)
				@historyTabButton("optimal", "Optimal complexity", -1)
			</div>
			<section class="tab-panel" id="tab-panel-attempts" role="tabpanel" aria-labelledby="tab-attempts">
				<h2>Previous attempts</h2>
				if len(attempts)==0 {
					<p class="muted">No attempts recorded yet.</p>
				}
				{{ latestCode := LatestCodeID(attempts) }}
				@compareForm(problem.Slug, CodeAttempts(attempts), "", "", review)
				for _, a:=range attempts {
					<article class="panel attempt" id={ AttemptAnchor(a.ID) }>
						<div class="problem-heading">
							<h3>
								{ AttemptLabel(a) }
							</h3><span>{ Count(a.Minutes) } min</span>
						</div>
						<p class="small muted">
							<time datetime={ a.CreatedAt.UTC().Format("2006-01-02T15:04:05Z07:00") }>
								{ AttemptStamp(review.AttemptTime(a)) }
							</time>
							if a.Quick() {
								if a.Outcome == QuickPartial {
									· Missed: { MissedLabel(a.Missed) }
								}
							} else if a.Assisted {
								· Used solution help
							} else {
								· No solution help
							}
							if kind := review.AttemptKind(a); kind != "" {
								· { kind }
							}
							if a.Approach != "" {
								· { ApproachLabel(a.Approach) }
							}
							if a.WantsReview {
								· Marked for review
							}
						</p>
						@correctnessAnswers(a.Correctness)
						@statedComplexity(a)
						if a.Notes!="" {
							<p class="notes">
								if a.Quick() {
									<span class="small muted">Recalled approach: </span>
								}
								{ a.Notes }
							</p>
						}
						if !a.Quick() {
							@attemptCode(problem.Slug, a, latestCode, review)
							@analysisCard(problem.Slug, a, state, avail)
							<details>
								<summary>Correct this attempt</summary>@attemptFields(problem, EditForm(a))
							</details>
						}
						<details>
							<summary>Delete this attempt</summary>
							<p class="small muted">Permanently delete this attempt, its saved code, and its analysis? Your stats and review schedule will use the remaining attempts. This cannot be undone.</p>
							<form method="post" action={ templ.SafeURL(ProblemURL(problem.Slug) + "/attempts/" + a.ID + "/delete") }>
								<button class="button" type="submit" name="confirm" value="yes">Delete attempt</button>
							</form>
						</details>
					</article>
				}
			</section>
			<section class="tab-panel panel" id="tab-panel-record" role="tabpanel" aria-labelledby="tab-record">
				<h2>{ RecordTabLabel(form) }</h2>@attemptFields(problem, form)
				if form.Error!="" && form.Revision!="" {
					<p>
						<a
							href={ templ.SafeURL(ProblemURL(problem.Slug)) }
						>Reload current history</a> before reapplying a conflicting correction. Your draft is shown above.
					</p>
				}
			</section>
			<section class="tab-panel" id="tab-panel-optimal" role="tabpanel" aria-labelledby="tab-optimal">
				@optimalPanel(problem, len(attempts) > 0, form.OptimalNotice)
			</section>
		</div>
	}
}

// historyTabButton is one tab of the problem page. count is shown when not negative.
templ historyTabButton(key, label string, count int) {
	<button class="tab" id={ "tab-" + key } type="button" role="tab" aria-controls={ "tab-panel-" + key } aria-selected="false" tabindex="-1" data-tab={ key }>
		{ label }
		if count >= 0 {
			<span class="tab-count">{ Count(count) }</span>
		}
	</button>
}

// optimalCell shows a problem's optimal time and space in the problems table.
templ optimalCell(p Problem) {
	if p.HasOptimal() {
		<span class="optimal-value"><abbr title="Time" aria-hidden="true">T</abbr><span class="visually-hidden">Time</span> { p.OptimalTime }</span>
		<span class="optimal-value"><abbr title="Space" aria-hidden="true">S</abbr><span class="visually-hidden">Space</span> { p.OptimalSpace }</span>
		if p.OptimalEstimated() || p.OptimalManual() {
			<span class="small muted estimate">{ p.OptimalSourceLabel() }</span>
		}
	} else {
		<span class="muted" aria-hidden="true">—</span><span class="visually-hidden">Not known yet</span>
	}
}

// optimalPanel reveals the optimal complexity only once the learner has
// attempted the problem, so the answer's shape is not given away beforehand.
templ optimalPanel(p Problem, attempted bool, notice string) {
	<div class="panel optimal-panel" id="optimal">
		<h2>Optimal complexity</h2>
		if notice != "" {
			<p class="notice" role="status">{ notice }</p>
		}
		if !attempted {
			<p class="small muted">The optimal time and space complexity appears after your first attempt.</p>
		} else if p.HasOptimal() {
			<dl>
				<dt>Optimal time</dt>
				<dd class="optimal-value">{ p.OptimalTime }</dd>
				<dt>Optimal space</dt>
				<dd class="optimal-value">{ p.OptimalSpace }</dd>
			</dl>
			if p.OptimalNote != "" {
				<p class="small muted">{ p.OptimalNote }</p>
			}
			<p class="small"><strong>{ p.OptimalSourceLabel() }</strong></p>
			if p.OptimalEstimated() {
				<p class="small muted">Claude's estimate from the first analysed attempt. Space excludes the returned output.</p>
			} else if p.OptimalManual() {
				<p class="small muted">Entered by you; Claude's estimates never replace it. Space excludes the returned output.</p>
			} else {
				<p class="small muted">Best-known bounds under the problem's constraints. Space excludes the returned output.</p>
			}
		} else {
			<p class="small muted">Not known yet. Claude estimates it when it analyses an attempt with captured code.</p>
		}
		if attempted {
			@optimalActions(p)
		}
	</div>
}

// Retired is shown for pages of the retired 84-day curriculum.
templ Retired() {
	@layout("Page retired", "") {
		<section class="panel">
			<h1>This page was retired</h1>
			<p>The 84-day curriculum, with its day pages and lessons, has been replaced by a daily goal and reviews. Your attempts are all still here.</p>
			<p><a class="button primary" href="/leetgrinder">Go to the dashboard</a></p>
		</section>
	}
}

// todaysReviews is today's review picks, one card each.
templ todaysReviews(today Today, ids map[string]string, ret string) {
	<section class="reviews" aria-labelledby="reviews-title">
		<div class="ui-section-header">
			<h2 class="ui-section-header__title" id="reviews-title">Today's review</h2>
			if ret != "reviews" {
				<a class="ui-label ui-section-header__meta" href="/leetgrinder/reviews">All reviews</a>
			}
		</div>
		if len(today.Reviews) == 0 {
			<p class="small muted">Nothing is due for review today.</p>
		} else {
			<p class="small muted">Re-solve each problem from scratch before looking at your old solution.</p>
			for _, item := range today.Reviews {
				@reviewCard(item, NewReviewForm(ids[ReviewKey(item.Problem.Slug)], ret), today.Now)
			}
		}
	</section>
}

// reviewCard is one review pick in a Box: kind and number, title, difficulty,
// recall and topics, the reason as a margin note, then OPEN and LOG ATTEMPT.
templ reviewCard(item ReviewItem, form AttemptForm, now time.Time) {
	<article class="ui-box review-card" id={ ReviewKey(item.Problem.Slug) }>
		<p class="ui-label">
			if item.Done {
				Reviewed today
			} else if item.Card.SpotCheck() {
				Spot check
			} else {
				Review
			}
			if NumberLabel(item.Problem.Number) != "" {
				· { NumberLabel(item.Problem.Number) }
			}
		</p>
		<h3 class="review-card-title">{ item.Problem.DisplayTitle() }</h3>
		<p class="review-card-meta">
			{ ReviewMeta(item, now) }
		</p>
		if item.Reason != "" {
			<p class="ui-note reason">{ item.Reason }</p>
		}
		<div class="review-card-actions">
			<a class="ui-btn" href={ templ.SafeURL(item.Problem.URL()) } target="_blank" rel="noopener noreferrer">Open<span class="visually-hidden"> { item.Problem.DisplayTitle() } on { item.Problem.Site() } (opens in a new tab)</span></a>
			<a class="ui-btn ui-btn--primary" href={ templ.SafeURL(ProblemURL(item.Problem.Slug)) }>Log attempt<span class="visually-hidden">: { item.Problem.DisplayTitle() }</span></a>
		</div>
		if link := item.Problem.NeetCodeURL(); link != "" || (!item.Done && item.Card.Reviews > 0 && item.Card.RequiredMode() == "") {
			<p class="review-card-links small">
				@neetcodeLink(item.Problem, "")
				if !item.Done && item.Card.Reviews > 0 && item.Card.RequiredMode() == "" {
					<a href={ templ.SafeURL(QuickURL(item.Problem.Slug, "")) }>Quick review</a>
				}
			</p>
		}
		if !item.Done && form.ID != "" {
			<details class="log-attempt">
				<summary>Record your review</summary>@attemptFields(item.Problem, form)
			</details>
		}
	</article>
}

templ Reviews(page ReviewsPage) {
	@layout("Reviews", "reviews") {
		<p class="eyebrow">SPACED REPETITION</p>
		<h1>Reviews</h1>
		<p class="lead">Problems you struggled with, scheduled by how likely you are to recall them. Flagged problems need work now and are due the next day; the rest come back on a spaced schedule.</p>
		<section class="stats" aria-label="Review summary">
			<div><strong>{ Count(len(page.Today.Reviews)) }</strong><p>Picked today</p></div>
			<div><strong>{ Count(page.Today.Backlog()) }</strong><p>Backlog</p></div>
			<div><strong>{ Count(len(page.Today.FlaggedCards())) }</strong><p>Flagged</p></div>
			<div><strong>{ Count(page.Today.Progress.Reviews()) }/{ Count(page.Today.Progress.ReviewTarget()) }</strong><p>Reviews toward today's goal</p></div>
			<div><strong>{ Count(page.Today.QuickReviews) }</strong><p>Quick reviews today</p></div>
		</section>
		<section class="panel" aria-labelledby="quick-title">
			<h2 id="quick-title">Quick review</h2>
			<p class="muted">A two-minute recall check without code: write the approach and its complexity, reveal your last solution, and grade yourself. Recalled takes a problem off the list; a few recalled problems come back later as a full re-solve.</p>
			if n := len(page.Today.QuickCards(nil)); n > 0 {
				<p><a class="button primary" href={ templ.SafeURL(BacklogURL("")) }>Clear backlog ({ Count(n) })</a></p>
			} else {
				<p class="muted small">Nothing is ready for a quick review.</p>
			}
		</section>
		@todaysReviews(page.Today, page.IDs, "reviews")
		<section class="queue" aria-labelledby="flagged-title">
			<h2 id="flagged-title">Flagged</h2>
			<p class="muted">Problems your latest attempt or its analysis flagged: a struggle, a simpler approach, a review request, or a complexity mistake. A clean re-solve clears the flag.</p>
			if cards := page.Today.FlaggedCards(); len(cards) == 0 {
				<p class="muted">Nothing is flagged right now.</p>
			} else {
				@reviewTable(page, cards, true)
			}
		</section>
		<section class="queue" aria-labelledby="spaced-title">
			<h2 id="spaced-title">Spaced review</h2>
			<p class="muted">Problems you struggled with before and have since solved cleanly. Each comes back when its recall estimate drops, a little later every time you solve it.</p>
			if cards := page.Today.SpacedCards(); len(cards) == 0 {
				if len(page.Today.ReviewCards()) == 0 {
					<p class="muted">A problem joins the review schedule once you struggle with it or flag it for review.</p>
				} else {
					<p class="muted">No past struggles are on a spaced schedule yet.</p>
				}
			} else {
				@reviewTable(page, cards, false)
			}
		</section>
	}
}

// reviewMode offers a quick review of a card, or says why it needs a full
// one. A spot check is named only once it is due.
templ reviewMode(today Today, card Card) {
	if today.QuickEligible(card) {
		<a href={ templ.SafeURL(QuickURL(card.Problem.Slug, "")) }>Quick review</a>
		if card.SuggestedMode() == ModeFull {
			<span class="small muted">· Full suggested</span>
		}
	} else if card.SpotCheck() && today.Due(card) {
		<span class="badge">Spot check</span>
		<span class="small muted">{ SpotCheckReason(card, today.Settings.Location()) }</span>
	} else if card.RequiresFull() {
		<span class="small">Full re-solve required</span>
	}
}

templ reviewTable(page ReviewsPage, cards []Card, flagged bool) {
	<div class="table-scroll">
		<table>
			<thead>
				<tr>
					<th scope="col">Problem</th><th scope="col">Last counted attempt</th><th scope="col">Due</th><th scope="col">Recall now</th>
					if flagged {
						<th scope="col">Flag</th>
					}
					<th scope="col">Review</th>
				</tr>
			</thead>
			<tbody>
				for _, card := range cards {
					<tr>
						<td>
							<a href={ templ.SafeURL(ProblemURL(card.Problem.Slug)) }>{ card.Problem.DisplayTitle() }</a>
							if page.Today.Picked(card.Problem.Slug) {
								<span class="badge">Today's pick</span>
							}
						</td>
						<td>{ AttemptLabel(card.Last) } · { DateLabel(Date(card.Last.CreatedAt, page.Today.Settings.Location())) }</td>
						<td>
							{ DateLabel(Date(card.Due, page.Today.Settings.Location())) }
							if page.Today.Due(card) {
								<span class="small overdue">Due</span>
							}
						</td>
						<td>{ Percent(card.Retrievability(page.Today.Now)) }</td>
						if flagged {
							<td><span class="small flag">{ card.Flag.Reason(page.Today.Now, page.Today.Settings.Location()) }</span></td>
						}
						<td>
							@reviewMode(page.Today, card)
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ SettingsView(page SettingsPage) {
	@layout("Settings", "settings") {
		<h1>Settings</h1>
		if page.Error != "" {
			<p class="error" role="alert">{ page.Error }</p>
		}
		if page.Saved {
			<p class="notice" role="status">Settings saved.</p>
		}
		<div class="settings-sections">
			@generalSettings(page)
			@notifySettings(page.Notify)
			@analysisSettings(page.Analysis)
			@apiTokenSettings(page)
		</div>
	}
}

templ generalSettings(page SettingsPage) {
	<section class="panel" id="general" aria-labelledby="general-settings-title">
		<h2 id="general-settings-title">Daily goal</h2>
		if page.ZoneImpact != nil {
			@zoneConfirm(page)
		}
		<form class="attempt-form settings-form" method="post" action="/leetgrinder/settings/general">
			<input type="hidden" name="revision" value={ page.General.Revision }/>
			<div class="form-row">
				<label>
					New problems a day
					<select name="goalNew" required>
						for _, n := range GoalOptions() {
							<option value={ n } selected?={ page.General.GoalNew == n }>{ n }</option>
						}
					</select>
				</label>
				<label>
					Reviews a day
					<select name="goalReview" required>
						for _, n := range GoalOptions() {
							<option value={ n } selected?={ page.General.GoalReview == n }>{ n }</option>
						}
					</select>
				</label>
			</div>
			<label>
				Time zone
				<input type="text" name="timezone" list="timezones" required value={ page.General.Timezone } autocomplete="off" spellcheck="false"/>
			</label>
			<datalist id="timezones">
				for _, tz := range timezoneSuggestions {
					<option value={ tz }></option>
				}
			</datalist>
			<label class="checkbox">
				<input type="checkbox" name="newFromTodos" value="true" checked?={ page.General.NewFromTodos }/>
				Pick today's new problems from my todos
			</label>
			<p class="small muted">Optional. Each day picks as many new problems as the goal asks for from the oldest todos whose problem you have not attempted before that day, and keeps them for the day like review picks. Todos and the goal work the same without it.</p>
			<label>
				Spot-check rate for quick reviews
				<select name="spotCheckRate" required>
					for _, n := range SpotCheckRateOptions() {
						<option value={ n } selected?={ page.General.SpotCheckRate == n }>{ n }%</option>
					}
				</select>
			</label>
			<p class="small muted">The share of recalled quick reviews that come back as a full re-solve at their next review, to catch grades that were too generous. If 2 of the last 5 spot checks fail, the rate goes up to 25% until 3 in a row pass. 0% turns spot checks off.</p>
			<p class="small muted">
				A new problem is one you have never attempted before today. A review counts toward the goal when the problem was due, flagged, or today's pick; other re-solves count as practice. Extra work is bonus, and each goal-met day extends your streak.
				if page.TodayGoal != nil {
					Today's goal is already set to { GoalLabel(*page.TodayGoal) }, so target changes apply from tomorrow; picking from todos starts today.
				} else {
					Changes apply from today.
				}
			</p>
			<button class="button primary" type="submit">Save</button>
		</form>
	</section>
}

templ zoneConfirm(page SettingsPage) {
	<form class="attempt-form settings-form" method="post" action="/leetgrinder/settings/general" aria-labelledby="zone-confirm-title">
		<h3 id="zone-confirm-title">Confirm the time zone change</h3>
		<p>
			Changing the time zone from { page.ZoneImpact.Before.Zone } to { page.ZoneImpact.After.Zone } recounts past days. Every attempt is placed on its local date in the new zone, so late-evening attempts can move to another day. Goals and review picks already frozen stay with their old dates, so past days can lose their picks or goals and your streaks can change. Nothing is saved yet.
		</p>
		<table class="zone-impact">
			<thead>
				<tr>
					<th scope="col"></th>
					<th scope="col">{ page.ZoneImpact.Before.Zone } (now)</th>
					<th scope="col">{ page.ZoneImpact.After.Zone } (after)</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<th scope="row">Current streak</th>
					<td>{ page.ZoneImpact.Before.Current } { DayUnit(page.ZoneImpact.Before.Current) }</td>
					<td>{ page.ZoneImpact.After.Current } { DayUnit(page.ZoneImpact.After.Current) }</td>
				</tr>
				<tr>
					<th scope="row">Longest streak</th>
					<td>{ page.ZoneImpact.Before.Longest } { DayUnit(page.ZoneImpact.Before.Longest) }</td>
					<td>{ page.ZoneImpact.After.Longest } { DayUnit(page.ZoneImpact.After.Longest) }</td>
				</tr>
				<tr>
					<th scope="row">Goal-met days, last { ZoneWeeks } weeks</th>
					<td>{ page.ZoneImpact.Before.MetDays }</td>
					<td>{ page.ZoneImpact.After.MetDays }</td>
				</tr>
			</tbody>
		</table>
		if page.ZoneImpact.Goal != page.ZoneImpact.SavedGoal {
			<p>Daily goal will change from { GoalLabel(page.ZoneImpact.SavedGoal) } to { GoalLabel(page.ZoneImpact.Goal) }.</p>
		}
		if !page.ZoneImpact.Changed() {
			<p class="small muted">These figures do not change.</p>
		}
		<input type="hidden" name="revision" value={ page.General.Revision }/>
		<input type="hidden" name="timezone" value={ page.General.Timezone }/>
		<input type="hidden" name="goalNew" value={ page.General.GoalNew }/>
		<input type="hidden" name="goalReview" value={ page.General.GoalReview }/>
		<input type="hidden" name="spotCheckRate" value={ page.General.SpotCheckRate }/>
		if page.General.NewFromTodos {
			<input type="hidden" name="newFromTodos" value="true"/>
		}
		<input type="hidden" name="confirm" value="1"/>
		<button class="button primary" type="submit">Change time zone and save</button>
		<a class="button" href="/leetgrinder/settings#general">Cancel</a>
	</form>
}

templ Problems(page ProblemsPage) {
	@layout("Problems", "problems") {
		<p class="eyebrow">PROBLEMS</p>
		<h1>Problems</h1>
		<p class="lead">Every LeetCode problem you have attempted. Search by title, LeetCode number, or topic, and filter by difficulty, topic, or your progress.</p>
		<form class="problem-filters" method="get" action="/leetgrinder/problems" role="search" aria-label="Filter problems">
			<label class="filter-search">
				Search
				<input type="search" name="q" value={ page.Filter.Query } maxlength="100" placeholder="Title, number, or topic" autocomplete="off"/>
			</label>
			<label>
				Difficulty
				<select name="difficulty">
					<option value="">All</option>
					for _, d := range []string{"Easy", "Medium", "Hard"} {
						<option value={ d } selected?={ page.Filter.Difficulty == d }>{ d }</option>
					}
				</select>
			</label>
			<label>
				Topic
				<select name="topic">
					<option value="">All topics</option>
					for _, t := range page.Topics {
						<option value={ t.Key } selected?={ page.Filter.Topic == t.Key }>{ t.Label }</option>
					}
				</select>
			</label>
			<label>
				Status
				<select name="status">
					<option value="">Any</option>
					for _, s := range ProblemStatusOptions() {
						<option value={ s.Key } selected?={ page.Filter.Status == s.Key }>{ s.Label }</option>
					}
				</select>
			</label>
			<label>
				Sort
				<select name="sort">
					for _, s := range ProblemSortOptions() {
						<option value={ s.Key } selected?={ page.Filter.Sort == s.Key }>{ s.Label }</option>
					}
				</select>
			</label>
			<div class="filter-actions">
				<button class="button primary" type="submit">Apply</button>
				if page.Filter.Active() {
					<a href="/leetgrinder/problems">Clear filters</a>
				}
			</div>
		</form>
		<p class="small muted" role="status">Showing { Count(len(page.Rows)) } of { Count(page.Total) } problems</p>
		if page.Total == 0 {
			<p class="panel muted">No attempts yet. <a href="/leetgrinder#log-attempt">Log an attempt</a> on any LeetCode problem to see it here.</p>
		} else if len(page.Rows) == 0 {
			<p class="panel muted">No problems match these filters. <a href="/leetgrinder/problems">Clear filters</a></p>
		} else {
			<div class="table-scroll queue problem-table">
				<table>
					<caption class="visually-hidden">Attempted problems</caption>
					<thead>
						<tr>
							<th scope="col">#</th>
							<th scope="col">Problem</th>
							<th scope="col">Difficulty</th>
							<th scope="col">Optimal time / space</th>
							<th scope="col">Status</th>
							<th scope="col">Attempts</th>
							<th scope="col">Last attempt</th>
							<th scope="col">Next due</th>
							<th scope="col">Link</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range page.Rows {
							<tr>
								<td class="num">
									if row.Problem.Number > 0 {
										{ Count(row.Problem.Number) }
									}
								</td>
								<th scope="row">
									<a href={ templ.SafeURL(ProblemURL(row.Problem.Slug)) }>{ row.Problem.DisplayTitle() }</a>
									if row.Problem.NotFound {
										<span class="small muted not-found">Not found on LeetCode</span>
									}
									if len(row.Problem.Topics) > 0 {
										<span class="row-topics">
											for _, t := range row.Problem.Topics {
												<a class="topic-tag" href={ templ.SafeURL("/leetgrinder/problems?topic=" + t) }>{ row.Problem.TopicLabel(t) }</a>
											}
										</span>
									}
								</th>
								<td>
									if row.Problem.Difficulty != "" {
										<span class={ DifficultyClass(row.Problem.Difficulty) }>{ row.Problem.Difficulty }</span>
									} else {
										<span class="muted" aria-hidden="true">—</span><span class="visually-hidden">Not known yet</span>
									}
								</td>
								<td class="optimal">@optimalCell(row.Problem)
</td>
								<td class="status">
									<div class="status-tags">
										<span class={ StatusClass(row.Latest) }><span class="visually-hidden">Latest: </span>{ row.Latest }</span>
										if row.Due {
											<span class="badge">Due</span>
										}
										if row.ComplexityWrong {
											@complexityBadge()
										}
										if row.Card.Flag != nil {
											<span class="small flag">{ row.Card.Flag.Label() }</span>
										}
										if ShowBest(row.Best, row.Latest) {
											<span class="small muted status-best">Best: <span class={ StatusClass(row.Best) }>{ row.Best }</span></span>
										}
									</div>
								</td>
								<td class="num">{ Count(row.Attempts) }</td>
								<td class="date">{ CompactDate(Date(row.Last.CreatedAt, page.Location)) }</td>
								<td class="date">
									if row.Card.Reviewable() || row.Due {
										{ CompactDate(Date(row.Card.Due, page.Location)) }
									}
								</td>
								<td>
									<div class="problem-site-links">
										<a href={ templ.SafeURL(row.Problem.URL()) } target="_blank" rel="noopener noreferrer">Open<span aria-hidden="true"> ↗</span><span class="visually-hidden"> { row.Problem.DisplayTitle() } on { row.Problem.Site() } (opens in a new tab)</span></a>
										@neetcodeLink(row.Problem, "")
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ attemptFields(problem Problem, form AttemptForm) {
	<form class="attempt-form" method="post" action={ templ.SafeURL(ProblemURL(problem.Slug) + "/attempts") }>
		<input type="hidden" name="id" value={ form.ID }/><input type="hidden" name="revision" value={ form.Revision }/>
		if form.Review {
			<input type="hidden" name="review" value="true"/>
		}
		if form.Return != "" {
			<input type="hidden" name="return" value={ form.Return }/>
		}
		if form.Error!="" {
			<p class="error" role="alert">
				{ form.Error }
			</p>
		}
		<div class="form-row"><label>Outcome<select name="outcome" required><option value="unfinished" selected?={ form.Outcome=="unfinished" }>Unfinished</option><option value="struggled" selected?={ form.Outcome=="struggled" }>Struggled</option><option value="solved" selected?={ form.Outcome=="solved" }>Solved</option></select></label><label>Minutes spent<input type="number" name="minutes" min="1" max="240" required value={ form.Minutes }/></label></div>
		@correctnessFields(form.Correctness)
		<fieldset class="complexity">
			<legend>Complexity <span class="muted">(required when solved or struggled)</span></legend>
			<div class="form-row">
				@complexityField("timeComplexity", "time", form.Time)
				@complexityField("spaceComplexity", "space", form.Space)
			</div>
		</fieldset>
		<label class="checkbox"><input type="checkbox" name="assisted" value="true" checked?={ form.Assisted }/>I used hints or reviewed a solution</label>
		<fieldset class="approach">
			<legend>Approach <span class="muted">(optional)</span></legend>
			<label class="checkbox"><input type="radio" name="approach" value="" checked?={ form.Approach=="" }/>Not stated</label>
			<label class="checkbox"><input type="radio" name="approach" value={ ApproachOptimal } checked?={ form.Approach==ApproachOptimal }/>{ ApproachLabel(ApproachOptimal) }</label>
			<label class="checkbox"><input type="radio" name="approach" value={ ApproachSuboptimal } checked?={ form.Approach==ApproachSuboptimal }/>{ ApproachLabel(ApproachSuboptimal) }</label>
		</fieldset>
		<label class="checkbox"><input type="checkbox" name="wantsReview" value="true" checked?={ form.WantsReview }/>I want to review this problem again soon</label>
		if form.Revision == "" {
			<details class="code-input" open?={ form.Code != "" }>
				<summary>Code <span class="muted">(optional)</span></summary>
				<label>
					Language
					<select name="codeLanguage">
						<option value="">Choose…</option>
						for _, l := range CodeLanguages {
							<option value={ l } selected?={ form.CodeLanguage == l }>{ LanguageLabel(l) }</option>
						}
					</select>
				</label>
				<label>
					Your solution
					<textarea name="code" rows="8" spellcheck="false" class="code-textarea" placeholder="Paste the code you wrote">{ "\n" + form.Code }</textarea>
				</label>
				<p class="small muted">Up to 64 KiB. Saved with the attempt and analysed like extension-captured code.</p>
			</details>
		}
		<label>
			Notes <span class="muted">(optional)</span>
			<textarea name="notes" rows="3" maxlength="2000" placeholder="What worked? Where did you get stuck?">
				{ form.Notes }
			</textarea>
		</label>
		<p class="small muted">Solved means your solution passed on LeetCode. Mark help even if you wrote the final code yourself. Anything but an unassisted solve, a simpler approach, or asking to review flags the problem for review the next day.</p>
		<button class="button primary" type="submit">
			if form.Revision!="" {
				Save correction
			} else {
				Save attempt
			}
		</button>
	</form>
}

// complexityField is a select of common classes plus a text field for any
// other value. It works without JavaScript; complexityScript only hides the
// text field until "Other…" is chosen.
templ complexityField(name string, label string, input ComplexityInput) {
	<div class="complexity-field" data-complexity>
		<label>
			<span class="capitalize">{ label }</span>
			<select name={ name }>
				<option value="" selected?={ input.Choice=="" }>Not stated</option>
				for _, c := range Complexities {
					<option value={ c } selected?={ input.Choice==c }>{ c }</option>
				}
				<option value="other" selected?={ input.Choice=="other" }>Other…</option>
			</select>
		</label>
		<label class="complexity-other">
			Other { label } complexity
			<input type="text" name={ name + "Other" } maxlength="40" placeholder="O(m·n)" autocomplete="off" spellcheck="false" value={ input.Other }/>
		</label>
	</div>
}

templ complexityScript() {
	<script>
		(() => {
			const sync = (select) => {
				const other = select.closest("[data-complexity]").querySelector(".complexity-other");
				const show = select.value === "other";
				other.hidden = !show;
				other.querySelector("input").disabled = !show;
			};
			document.querySelectorAll("[data-complexity] select").forEach(sync);
			document.addEventListener("change", (event) => {
				if (event.target instanceof HTMLSelectElement && event.target.closest("[data-complexity]")) sync(event.target);
			});
		})();
	</script>
}

templ statedComplexity(a Attempt) {
	if a.TimeComplexity != "" || a.SpaceComplexity != "" {
		<p class="small stated-complexity">
			Time <strong>{ orDash(a.TimeComplexity) }</strong> · Space <strong>{ orDash(a.SpaceComplexity) }</strong>
		</p>
	}
}

templ attemptCode(slug string, a Attempt, latest string, review ProblemReview) {
	if a.Code != "" {
		<details class="attempt-code" open?={ a.ID == latest }>
			<summary>
				if a.ID == latest {
					<span class="badge">Latest code</span>
				}
				Submitted code ({ LanguageLabel(a.CodeLanguage) }, { ByteSize(len(a.Code)) })
			</summary>
			<div class="code-actions">
				<button type="button" class="button small" data-copy={ "code-" + a.ID } hidden>Copy code</button>
				if latest != "" && a.ID != latest {
					<a class="small" href={ templ.SafeURL(CompareURL(slug, a.ID, latest)) }>Compare with latest code</a>
				}
			</div>
			<pre class="chroma"><code id={ "code-" + a.ID } data-language={ a.CodeLanguage }>@templ.Raw(string(HighlightCode(a.Code, a.CodeLanguage)))</code></pre>
		</details>
	}
}

// compareForm picks two attempts' code to compare, when there are two.
templ compareForm(slug string, attempts []Attempt, from string, to string, review ProblemReview) {
	if len(attempts) >= 2 {
		{{
	if from == "" {
		from = attempts[1].ID
	}
	if to == "" {
		to = attempts[0].ID
	}
		}}
		<form class="compare-form" method="get" action={ templ.SafeURL(ProblemURL(slug) + "/compare") }>
			<label>
				Compare
				<select name="from">
					for _, a := range attempts {
						<option value={ a.ID } selected?={ a.ID == from }>{ CodeChoiceLabel(a, review) }</option>
					}
				</select>
			</label>
			<label>
				with
				<select name="to">
					for _, a := range attempts {
						<option value={ a.ID } selected?={ a.ID == to }>{ CodeChoiceLabel(a, review) }</option>
					}
				</select>
			</label>
			<button class="button" type="submit">Compare code</button>
		</form>
	}
}

// CompareCode shows a line diff between two attempts' code.
templ CompareCode(page CompareCodePage) {
	@layout("Compare code", "problems") {
		<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/leetgrinder/problems">Problems</a><span>/</span><a href={ templ.SafeURL(ProblemURL(page.Problem.Slug)) }>{ page.Problem.DisplayTitle() }</a><span>/</span><span>Compare code</span></nav>
		<h1>Compare code</h1>
		@compareForm(page.Problem.Slug, page.Choices, page.From.ID, page.To.ID, page.Review)
		<p class="small muted">
			From { CodeChoiceLabel(page.From, page.Review) } ({ LanguageLabel(page.From.CodeLanguage) }) to { CodeChoiceLabel(page.To, page.Review) } ({ LanguageLabel(page.To.CodeLanguage) }).
		</p>
		if page.TooLarge {
			<p class="error" role="alert">This code is too long to compare line by line.</p>
		} else {
			{{ removed, added := DiffCounts(page.Lines) }}
			<p class="small"><span class="diff-del-key">−{ Count(removed) }</span> <span class="diff-add-key">+{ Count(added) }</span> lines</p>
			<div class="table-scroll">
				<pre class="code-diff"><code>
					for _, l := range page.Lines {
						<span class={ DiffClass(l.Op) }><span class="diff-op" aria-hidden="true">{ string(l.Op) }</span><span class="visually-hidden">{ DiffLabel(l.Op) }</span>{ l.Text }</span>
					}
				</code></pre>
			</div>
		}
	}
}

// tabsScript turns a [data-tabs] block into tabs. Without it every panel
// stays visible, stacked. A URL hash inside a panel opens that panel.
templ tabsScript() {
	<script>
		(() => {
			document.querySelectorAll("[data-tabs]").forEach((root) => {
				const tabs = [...root.querySelectorAll("[role=tab]")];
				const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")));
				const select = (index, focus) => {
					tabs.forEach((tab, i) => {
						const on = i === index;
						tab.setAttribute("aria-selected", String(on));
						tab.tabIndex = on ? 0 : -1;
						panels[i].hidden = !on;
					});
					if (focus) tabs[index].focus();
				};
				const fromHash = () => {
					const id = decodeURIComponent(location.hash.slice(1));
					const target = id && document.getElementById(id);
					const index = target ? panels.findIndex((panel) => panel.contains(target)) : -1;
					if (index < 0) return false;
					select(index, false);
					target.scrollIntoView();
					return true;
				};
				tabs.forEach((tab, i) => {
					tab.addEventListener("click", () => select(i, false));
					tab.addEventListener("keydown", (event) => {
						const last = tabs.length - 1;
						const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[event.key];
						if (next === undefined) return;
						event.preventDefault();
						select(next, true);
					});
				});
				root.querySelector("[role=tablist]").hidden = false;
				root.classList.add("tabs-ready");
				if (!fromHash()) select(Math.max(0, tabs.findIndex((tab) => tab.dataset.tab === root.dataset.tabs)), false);
				window.addEventListener("hashchange", fromHash);
			});
		})();
	</script>
}

// copyScript shows each Copy code button and copies its code block.
templ copyScript() {
	<script>
		(() => {
			if (!navigator.clipboard) return;
			document.querySelectorAll("[data-copy]").forEach((button) => {
				button.hidden = false;
				button.addEventListener("click", async () => {
					const code = document.getElementById(button.dataset.copy);
					try {
						await navigator.clipboard.writeText(code.textContent);
						button.textContent = "Copied";
					} catch {
						button.textContent = "Copy failed";
					}
					setTimeout(() => { button.textContent = "Copy code"; }, 2000);
				});
			});
		})();
	</script>
}

templ Unavailable(message string) {
	@layout("Unable to load", "") {
		<section class="panel">
			<h1>Unable to load your progress</h1>
			<p role="alert">
				{ message }
			</p>
			<p><a href="/leetgrinder">Try again</a></p>
		</section>
	}
}

templ Stats(page StatsPage) {
	@layout("Stats", "stats") {
		<p class="eyebrow">STATS</p>
		<h1>Stats</h1>
		<p class="lead">Where recall is weakest, by LeetCode topic, with your difficulty mix, weekly trends and goal calendar.</p>
		@statTiles(page.Headline(), len(page.Calendar))
		@quickStats(page)
		<section class="queue" aria-labelledby="topics-title">
			<div class="section-heading">
				<h2 id="topics-title">Topics</h2>
				<form class="problem-filters" method="get" action="/leetgrinder/stats" aria-label="Sort topics">
					<label>
						Sort
						<select name="sort">
							for _, s := range StatSortOptions() {
								<option value={ s.Key } selected?={ page.Filter.Sort == s.Key }>{ s.Label }</option>
							}
						</select>
					</label>
					<label class="checkbox"><input type="checkbox" name="all" value="1" checked?={ page.Filter.All }/>List topics with fewer than 3 problems</label>
					<div class="filter-actions"><button class="button primary" type="submit">Apply</button></div>
				</form>
			</div>
			if len(page.Topics) == 0 {
				<p class="muted">Log attempts to see how each topic is going.</p>
			} else {
				@topicChart(page.Topics)
				<details class="chart-table">
					<summary>Show topics as a table</summary>
					<div class="table-scroll">
						<table>
							<caption class="visually-hidden">Topics, weakest recall first by default</caption>
							<thead><tr><th scope="col">Topic</th><th scope="col">Problems</th><th scope="col">Solved</th><th scope="col">Struggle rate</th><th scope="col">Average recall</th><th scope="col">Due</th></tr></thead>
							<tbody>
								for _, t := range page.Topics {
									<tr>
										<th scope="row">
											if t.Key == "other" {
												{ t.Label }
											} else {
												<a href={ templ.SafeURL("/leetgrinder/problems?topic=" + t.Key) }>{ t.Label }</a>
											}
										</th>
										<td class="num">{ Count(t.Problems) }</td>
										<td class="num">{ Count(t.Solved) }</td>
										<td class="num">{ Percent(t.StruggleRate()) }</td>
										<td class="num">{ Percent(t.Recall()) }</td>
										<td class="num">{ Count(t.Due) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</details>
				<p class="small muted">Struggle rate counts attempts that struggled, stayed unfinished, or used help. A problem counts under each of its topics; topics with fewer than 3 problems are grouped under Other.</p>
			}
		</section>
		<section class="queue stats-block" aria-labelledby="difficulty-title">
			<h2 id="difficulty-title">Difficulty mix</h2>
			<p class="small muted chart-legend"><span class="legend-key legend-solved"></span> solved · <span class="legend-key legend-open"></span> attempted, not solved yet</p>
			<ul class="diff-bars">
				for _, d := range page.DifficultyBars() {
					<li>
						<span class="diff-bar-label">
							if d.Difficulty != "" {
								<span class={ DifficultyClass(d.Difficulty) }>{ d.Difficulty }</span>
							} else {
								<span class="muted">Unknown</span>
							}
						</span>
						<svg class="diff-bar" viewBox="0 0 100 12" preserveAspectRatio="none" role="img" aria-label={ DifficultyLabel(d.Difficulty) + ": " + Count(d.Solved) + " solved of " + Count(d.Attempted) + " attempted" }>
							<title>{ DifficultyLabel(d.Difficulty) + ": " + Count(d.Solved) + " solved of " + Count(d.Attempted) + " attempted" }</title>
							<rect class="diff-bar-track" width="100" height="12" rx="2"></rect>
							<rect class="diff-bar-solved" width={ d.SolvedWidth } height="12"></rect>
							<rect class="diff-bar-open" x={ d.OpenX } width={ d.OpenWidth } height="12"></rect>
						</svg>
						<span class="num diff-bar-value"><strong>{ Count(d.Solved) }</strong> of { Count(d.Attempted) }</span>
					</li>
				}
			</ul>
		</section>
		@trendsSection(page.Trends)
		<section class="stats-block" aria-labelledby="calendar-title">
			<h2 id="calendar-title">Goal calendar</h2>
			<p class="small muted">The last { Count(len(page.Calendar)) } weeks. <span class="cal-key cal-met"></span> goal met · <span class="cal-key cal-active"></span> practised · <span class="cal-key"></span> no attempts</p>
			<table class="goal-calendar">
				<caption class="visually-hidden">Goal-met days by week</caption>
				<thead><tr><th scope="col"><span class="visually-hidden">Week of</span></th><th scope="col"><abbr title="Monday">Mo</abbr></th><th scope="col"><abbr title="Tuesday">Tu</abbr></th><th scope="col"><abbr title="Wednesday">We</abbr></th><th scope="col"><abbr title="Thursday">Th</abbr></th><th scope="col"><abbr title="Friday">Fr</abbr></th><th scope="col"><abbr title="Saturday">Sa</abbr></th><th scope="col"><abbr title="Sunday">Su</abbr></th></tr></thead>
				<tbody>
					for _, week := range page.Calendar {
						<tr>
							<th scope="row" class="small muted">{ week[0].Date.Format("2 Jan") }</th>
							for _, d := range week {
								<td class={ CalendarClass(d) } title={ CalendarTitle(d) }><span class="visually-hidden">{ CalendarTitle(d) }</span></td>
							}
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}

// statTiles is the headline row: progress, streak, goal days and reviews due.
templ statTiles(h StatsHeadline, weeks int) {
	<dl class="stat-tiles">
		<div>
			<dt>Problems solved</dt>
			<dd><strong>{ Count(h.Solved) }</strong> <span class="muted">of { Count(h.Attempted) } attempted</span></dd>
		</div>
		<div>
			<dt>Solved independently</dt>
			<dd><strong>{ h.Independent }</strong> <span class="muted">of solved problems</span></dd>
		</div>
		<div>
			<dt>Current streak</dt>
			<dd><strong>{ Count(h.Streak.Current) }</strong> <span class="muted">{ DayUnit(h.Streak.Current) } · longest { Count(h.Streak.Longest) }</span></dd>
		</div>
		<div>
			<dt>Goal met</dt>
			<dd><strong>{ Count(h.GoalMet) }</strong> <span class="muted">{ DayUnit(h.GoalMet) } of { Count(h.Practised) } practised, last { Count(weeks) } weeks</span></dd>
		</div>
		<div>
			<dt>Due today</dt>
			<dd><strong>{ Count(h.Due) }</strong> <span class="muted">{ plural(h.Due, "review", "reviews") } · <a href="/leetgrinder/reviews">open reviews</a></span></dd>
		</div>
	</dl>
}

// topicChart shows each topic's average recall and struggle rate as bars
// on a shared 0-100% scale, in the page's sort order.
templ topicChart(topics []TopicStat) {
	<div class="topic-chart" role="table" aria-label="Average recall and struggle rate by topic">
		<div class="topic-row topic-head" role="row">
			<span role="columnheader">Topic</span>
			<span role="columnheader">Average recall</span>
			<span role="columnheader">Struggle rate</span>
		</div>
		for _, t := range topics {
			<div class="topic-row" role="row">
				<span class="topic-name" role="rowheader">
					if t.Key == "other" {
						{ t.Label }
					} else {
						<a href={ templ.SafeURL("/leetgrinder/problems?topic=" + t.Key) }>{ t.Label }</a>
					}
					<span class="small muted">{ Count(t.Problems) } { plural(t.Problems, "problem", "problems") } · { Count(t.Solved) } solved
						if t.Due > 0 {
							· <span class="topic-due">{ Count(t.Due) } due</span>
						}
					</span>
				</span>
				<span role="cell">
					@rateBar("recall", t.Label+": average recall "+Percent(t.Recall()), t.Recall())
				</span>
				<span role="cell">
					@rateBar("struggle", t.Label+": struggle rate "+Percent(t.StruggleRate())+" of "+Count(t.Attempts)+" "+plural(t.Attempts, "attempt", "attempts"), t.StruggleRate())
				</span>
			</div>
		}
	</div>
}

// rateBar is a share drawn as a bar out of 100% with its value beside it.
templ rateBar(kind string, title string, f float64) {
	<span class="rate-cell">
		<svg class={ "rate-bar rate-" + kind } viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false"><title>{ title }</title><rect class="rate-track" width="100" height="10" rx="2"></rect><rect class="rate-fill" width={ BarWidth(f, 1) } height="10" rx="2"></rect></svg>
		<span class="num">{ Percent(f) }</span>
	</span>
}

// trendsSection charts weekly problems solved and the independent and
// complexity-check rates, with the full weekly table behind a toggle.
templ trendsSection(t Trends) {
	<section class="queue stats-block" aria-labelledby="trends-title">
		<h2 id="trends-title">Weekly trends</h2>
		if len(t.Weeks) == 0 {
			<p class="muted small">Trends appear after your first attempt.</p>
		} else {
			<p class="small muted">Weeks run Monday to Sunday in your time zone, for at most the last { Count(t.Limit) } weeks, leaving out weeks before your first attempt. Hover a week for its numbers.</p>
			<div class="chart-grid">
				<figure class="chart">
					<figcaption>Problems solved per week</figcaption>
					if t.MaxSolved == 0 {
						<p class="muted small">Columns appear after your first solve.</p>
					} else {
						@solvedChart(t.SolvedChart())
					}
				</figure>
				<figure class="chart">
					<figcaption>Independent solves and complexity checks right</figcaption>
					if c := t.RateChart(); c.Empty() {
						<p class="muted small">Rates appear after your first solve or Claude complexity check.</p>
					} else {
						<p class="small muted chart-legend"><span class="legend-line legend-independent"></span> independent solves · <span class="legend-line legend-accuracy"></span> complexity checks right</p>
						@rateChart(c)
					}
				</figure>
			</div>
			<details class="chart-table">
				<summary>Show weekly trends as a table</summary>
				<p class="small muted">Independent is the share of solves without help; complexity checks are the stated values Claude's analysis judged right.</p>
				<div class="table-scroll">
					<table class="trends">
						<thead>
							<tr>
								<th scope="col">Week of</th>
								<th scope="col">Problems solved</th>
								<th scope="col">Independent</th>
								for _, d := range TrendDifficulties {
									<th scope="col">{ d } avg</th>
								}
								<th scope="col">Complexity checks</th>
							</tr>
						</thead>
						<tbody>
							for _, w := range t.Weeks {
								<tr>
									<th scope="row">{ w.Start.Format("2 Jan") }</th>
									<td>
										@trendBar(Count(w.Solved), BarWidth(float64(w.Solved), float64(t.MaxSolved)))
									</td>
									<td>
										if rate, ok := w.IndependentRate(); ok {
											@trendBar(RateLabel(rate, ok)+" of "+Count(w.Solves), BarWidth(rate, 1))
										} else {
											—
										}
									</td>
									for _, d := range TrendDifficulties {
										<td class="num">{ MinutesLabel(w.AverageMinutes(d)) }</td>
									}
									<td>
										if acc, ok := w.Accuracy(); ok {
											@trendBar(RateLabel(acc, ok)+" of "+Count(w.Checked), BarWidth(acc, 1))
										} else {
											—
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</details>
		}
	</section>
}

templ chartAxes(ticks []ChartTick, labels []ChartLabel) {
	for _, tick := range ticks {
		<line class="chart-grid-line" x1={ ChartLeft() } x2={ ChartRight() } y1={ tick.Y } y2={ tick.Y }></line>
		<text class="chart-axis" x={ ChartLeft() } y={ tick.Y } dx="-6" dy="4" text-anchor="end">{ tick.Label }</text>
	}
	for _, l := range labels {
		<text class="chart-axis" x={ l.X } y={ ChartAxisLabelY() } text-anchor="middle">{ l.Label }</text>
	}
}

templ solvedChart(c SolvedChart) {
	<svg class="chart-svg" viewBox={ ChartViewBox() } role="img" aria-label="Problems solved per week; open Show weekly trends as a table below for every week">
		@chartAxes(c.Ticks, c.Labels)
		for _, b := range c.Bars {
			<g class="chart-mark">
				<title>{ b.Title }</title>
				<rect class="chart-hit" x={ b.HitX } y={ ChartTop() } width={ b.HitW } height={ ChartPlotH() }></rect>
				if b.Path != "" {
					<path class="chart-bar" d={ b.Path }></path>
				}
				if b.Labelled {
					<text class="chart-value" x={ b.LabelX } y={ b.LabelY } text-anchor="middle">{ Count(b.Value) }</text>
				}
			</g>
		}
	</svg>
}

templ rateChart(c RateChart) {
	<svg class="chart-svg" viewBox={ ChartViewBox() } role="img" aria-label="Weekly independent-solve rate and complexity-check accuracy; open Show weekly trends as a table below for every week">
		@chartAxes(c.Ticks, c.Labels)
		for _, h := range c.Hits {
			<rect class="chart-hit" x={ h.HitX } y={ ChartTop() } width={ h.HitW } height={ ChartPlotH() }><title>{ h.Title }</title></rect>
		}
		for _, s := range c.Series {
			<g class={ "chart-series series-" + s.Key }>
				<path class="chart-line" d={ s.Path }></path>
				for _, p := range s.Points {
					<circle class="chart-dot" cx={ p.X } cy={ p.Y } r="4"><title>{ p.Title }</title></circle>
				}
				if s.EndLabel != "" {
					<text class="chart-value chart-end-label" x={ ChartGutterX() } y={ s.LabelY } dominant-baseline="middle">{ s.EndLabel }</text>
				}
			</g>
		}
	</svg>
}

// trendBar is a value with a bar whose width is out of 100.
templ trendBar(label string, width string) {
	<span class="trend-cell">
		<svg class="trend-bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="trend-track" width="100" height="8"></rect><rect class="trend-fill" width={ width } height="8"></rect></svg>
		<span class="num">{ label }</span>
	</span>
}

templ neetcodeLink(problem Problem, class string) {
	if link := problem.NeetCodeURL(); link != "" {
		<a class={ class } href={ templ.SafeURL(link) } target="_blank" rel="noopener noreferrer">NeetCode<span aria-hidden="true"> ↗</span><span class="visually-hidden"> { problem.DisplayTitle() } (opens in a new tab)</span></a>
	}
}

// quickStats summarises quick reviews and spot checks, tracked apart from
// solves.
templ quickStats(page StatsPage) {
	<section class="queue" aria-labelledby="quick-stats-title">
		<h2 id="quick-stats-title">Quick reviews</h2>
		<p class="muted small">Recall checks without code, counted apart from solves: they do not change the independent-solve rate or the minutes, but their complexities count toward complexity-check accuracy.</p>
		<dl class="review-state">
			<dt>Quick reviews</dt>
			<dd>{ Count(page.Quick.Count) }</dd>
			<dt>Recall rate</dt>
			<dd>{ RateLabel(page.Quick.RecallRate()) }</dd>
			<dt>Spot checks passed</dt>
			<dd>{ Count(page.SpotChecks.Passed) }</dd>
			<dt>Spot checks failed</dt>
			<dd>{ Count(page.SpotChecks.Failed) }</dd>
			<dt>Spot-check rate</dt>
			<dd>
				{ Count(page.SpotChecks.Rate) }%
				if page.SpotChecks.Elevated {
					<span class="small muted">(raised after failed spot checks)</span>
				}
			</dd>
		</dl>
	</section>
}
