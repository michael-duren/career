# Authentication Settings
# Optional locally: npm run dev supplies missing auth settings.
# Copy this file to .env to configure custom credentials.

# JWT Secret Key (generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-key-here

# Authentication Credentials
AUTH_USERNAME=admin

# Password Hash (use bcrypt to hash your password)
# Required for deployments. npm run dev replaces this placeholder locally.
# Generate hash: https://bcrypt-generator.com/ or use Node.js bcrypt library
AUTH_PASSWORD_HASH=$2a$10$YourHashedPasswordHere

# Netlify URL (used for server-side auth verification)
URL=https://your-site.netlify.app

# MCP OAuth (server-side Functions settings; disabled until explicitly enabled).
# See MCP.md. Use a separate staging issuer/resource and the owner's immutable subject.
CAREER_MCP_AUTH_MODE=disabled
CAREER_MCP_RESOURCE=https://your-site.netlify.app/api/mcp
CAREER_MCP_OAUTH_ISSUER=https://your-authorization-server.example
CAREER_MCP_OAUTH_JWKS_URI=https://your-authorization-server.example/jwks
# Defaults to CAREER_MCP_RESOURCE; must identify this MCP resource exclusively.
CAREER_MCP_OAUTH_AUDIENCE=https://your-site.netlify.app/api/mcp
CAREER_MCP_OWNER_SUBJECT=your-immutable-owner-subject
# at+jwt requires an RFC 9068 access-token header; token_use requires token_use=access.
CAREER_MCP_TOKEN_PROFILE=at+jwt
# Exact comma-separated origins for clients that make browser-side requests; empty by default.
CAREER_MCP_ALLOWED_ORIGINS=
# Explicit machine identities, e.g. [{"subject":"service-subject","clientId":"scheduler"}]
CAREER_MCP_SERVICE_IDENTITIES=[]

# Go/PostgreSQL migration runtime (separate from Netlify development above).
APP_ENV=development
DATABASE_URL=postgres://career_dev:career_dev_local@127.0.0.1:5433/career_dev?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
STATIC_DIR=dist
