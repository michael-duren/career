# Authentication Settings (read by the Go server)
# Run npm run setup, or copy this file to .env for local development.

# Local-only session secret; npm run setup generates a random value.
JWT_SECRET=local-development-only-session-secret

# Authentication Credentials
AUTH_USERNAME=admin

# Local login: admin / password123. Never use these credentials in production.
# Single-quote bcrypt hashes to preserve their dollar signs.
AUTH_PASSWORD_HASH='$2b$10$DgkrAm6JRG906Gr0BZZ9C.wEBc9Yg0Wm.QetZAgR.20UsQ12ekaHK'

# Origin used by src/lib/auth.ts for server-side auth verification.
URL=http://localhost:8080

# Legacy TypeScript MCP OAuth (not deployed; only scripts/career-mcp.mjs and its tests read these).
# The Go server serves /api/mcp with built-in OAuth and needs no MCP settings. See docs/mcp/README.md. Use a separate staging issuer/resource and the owner's immutable subject.
CAREER_MCP_AUTH_MODE=disabled
CAREER_MCP_RESOURCE=https://your-site.example/api/mcp
CAREER_MCP_OAUTH_ISSUER=https://your-authorization-server.example
CAREER_MCP_OAUTH_JWKS_URI=https://your-authorization-server.example/jwks
# Defaults to CAREER_MCP_RESOURCE; must identify this MCP resource exclusively.
CAREER_MCP_OAUTH_AUDIENCE=https://your-site.example/api/mcp
CAREER_MCP_OWNER_SUBJECT=your-immutable-owner-subject
# at+jwt requires an RFC 9068 access-token header; token_use requires token_use=access.
CAREER_MCP_TOKEN_PROFILE=at+jwt
# Exact comma-separated origins for clients that make browser-side requests; empty by default.
CAREER_MCP_ALLOWED_ORIGINS=
# Explicit machine identities, e.g. [{"subject":"service-subject","clientId":"scheduler"}]
CAREER_MCP_SERVICE_IDENTITIES=[]

# Go/PostgreSQL runtime.
APP_ENV=development
DATABASE_URL=postgres://career_dev:career_dev_local@127.0.0.1:5433/career_dev?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
STATIC_DIR=dist
# Encrypts the Leetgrinder ntfy token: 32 bytes, base64 (openssl rand -base64 32).
# Unset in development derives a key from JWT_SECRET; production requires it once a token is stored.
LEETGRINDER_SECRET_KEY=
# Leetgrinder complexity analysis via the Anthropic API. Leave the key empty to
# keep analysis off; it is read from the environment only and never stored.
# Captured attempt code is sent to Anthropic only while this is set and the
# settings toggle is on.
ANTHROPIC_API_KEY=
# Model ID (default claude-sonnet-5) and requests per local day (default 50; 0 sends none).
LEETGRINDER_ANALYSIS_MODEL=claude-sonnet-5
LEETGRINDER_ANALYSIS_DAILY_LIMIT=50

# OpenTelemetry metrics (Go API). Unset values fall back to the values below;
# the endpoint falls back only outside production. Set
# OTEL_EXPORTER_OTLP_ENDPOINT= (empty) to print metrics to stdout instead;
# production with no endpoint also uses stdout.
# OTLP gRPC endpoint: http:// disables TLS (local collector), https:// enables it.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=career-strategy
# Metric export interval in milliseconds (SDK default 60000).
OTEL_METRIC_EXPORT_INTERVAL=10000
# Optional: auth headers and custom CA for a remote collector.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token
# OTEL_EXPORTER_OTLP_CERTIFICATE=/path/to/ca.pem

# Local-only asynchronous running note transcription (disabled until provisioned).
RUNNING_TRANSCRIBE_ENABLED=false
WHISPER_URL=http://whisper:8080
WHISPER_MODEL=ggml-base.en

# Optional Weekly Scheduler Google Calendar connection. Register the callback
# ${PUBLIC_ORIGIN}/api/scheduler/google/callback in your Google OAuth web client.
SCHEDULER_GOOGLE_CLIENT_ID=
SCHEDULER_GOOGLE_CLIENT_SECRET=
# Base64 encoding of exactly 32 random bytes; retain this key across restarts.
SCHEDULER_SECRET_KEY=
