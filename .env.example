# Authentication Settings (read by the Go server)
# Copy this file to .env to configure credentials.

# JWT Secret Key (generate a secure random string)
JWT_SECRET=your-secure-jwt-secret-key-here

# Authentication Credentials
AUTH_USERNAME=admin

# Password Hash (bcrypt). Generate with: go run ./cmd/api hash-password
# Single-quote it in .env to preserve the dollar signs. Unset disables login in development.
AUTH_PASSWORD_HASH='$2a$10$YourHashedPasswordHere'

# Origin used by src/lib/auth.ts for server-side auth verification.
URL=http://localhost:8080

# MCP OAuth (deferred: the Go server does not serve MCP; only the MCP scripts read these).
# See docs/mcp/README.md. Use a separate staging issuer/resource and the owner's immutable subject.
CAREER_MCP_AUTH_MODE=disabled
CAREER_MCP_RESOURCE=https://your-site.example/api/mcp
CAREER_MCP_OAUTH_ISSUER=https://your-authorization-server.example
CAREER_MCP_OAUTH_JWKS_URI=https://your-authorization-server.example/jwks
# Defaults to CAREER_MCP_RESOURCE; must identify this MCP resource exclusively.
CAREER_MCP_OAUTH_AUDIENCE=https://your-site.example/api/mcp
CAREER_MCP_OWNER_SUBJECT=your-immutable-owner-subject
# at+jwt requires an RFC 9068 access-token header; token_use requires token_use=access.
CAREER_MCP_TOKEN_PROFILE=at+jwt
# Exact comma-separated origins for clients that make browser-side requests; empty by default.
CAREER_MCP_ALLOWED_ORIGINS=
# Explicit machine identities, e.g. [{"subject":"service-subject","clientId":"scheduler"}]
CAREER_MCP_SERVICE_IDENTITIES=[]

# Go/PostgreSQL runtime.
APP_ENV=development
DATABASE_URL=postgres://career_dev:career_dev_local@127.0.0.1:5433/career_dev?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
STATIC_DIR=dist

# OpenTelemetry metrics (Go API). Unset values fall back to the values below;
# the endpoint falls back only outside production. Set
# OTEL_EXPORTER_OTLP_ENDPOINT= (empty) to print metrics to stdout instead;
# production with no endpoint also uses stdout.
# OTLP gRPC endpoint: http:// disables TLS (local collector), https:// enables it.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=career-strategy
# Metric export interval in milliseconds (SDK default 60000).
OTEL_METRIC_EXPORT_INTERVAL=10000
# Optional: auth headers and custom CA for a remote collector.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token
# OTEL_EXPORTER_OTLP_CERTIFICATE=/path/to/ca.pem

# Local-only asynchronous running note transcription (disabled until provisioned).
RUNNING_TRANSCRIBE_ENABLED=false
WHISPER_URL=http://whisper:8080
WHISPER_MODEL=ggml-base.en
